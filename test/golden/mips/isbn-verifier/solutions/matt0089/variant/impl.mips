# | Register | Usage     | Type    | Description                              |
# | -------- | --------- | ------- | ---------------------------------------- |
# | `$a0`    | input     | address | null-terminated input string             |
# | `$v0`    | output    | boolean | valid isbn (`0` = `false`, `1` = `true`) |
# | `$t0-9`  | temporary | any     | used for temporary storage               |

.globl is_valid

# ## High level
# int n = strlen(s);
# int count = 10;
# char c;
# int accum = 0;
# for (int i = 0; i < strlen(s); i++) {
#     c = s[i];
#     if (c == '-') continue;
#     if ((c == 'X') && (count == 1)) {
#         accum += 10*1;
#         count--;
#         continue;
#     }
#     c = (int)(c - '0');
#     if ((c >= 0) && (c < 10)) {
#         // accumulate value
#         accum += count*c;
#         count--;
#     } else {
#         // invalid char, return failure
#         return -1;
#     }
# }
# 
# return (accum % 11)
#


# ## Low level
#

is_valid:
        add     $t0,    $a0,    $zero # char *
        addi    $t1,    $zero,  10     # counter
        addi    $t3,    $zero,  '-'
        addi    $t4,    $zero,  'X'
        addi    $t7,    $zero,  1      # const for compare
        addi    $t6,    $zero,  1      #accum
        
__loop:
        lb      $t5,    ($t0)              # load char
        beq     $t5,    $zero,  __calcmod  # done loop
        beq     $t5,    $t3,    __continue # continue if '-'
        beq     $t5,    $t4,    __add10    # handle 'X'
__addN:
        slti    $t8,    $t5,    0x30       # want this false (0)
        bne     $t8,    $zero,  __exitfail
        slti    $t9,    $t5,    0x3a       # want this true (1)
        beq     $t9,    $zero,  __exitfail
        # $t5 is between 0 and 10, ok
        addi    $t5,    $t5,    -0x30       # add value*counter into accum
        mult    $t5,    $t1
        mflo    $t5
        add     $t6,    $t6,    $t5
        addi    $t1,    $t1,    -1         # decrement counter
__continue:
        addi    $t0,    $t0,    1          # increment string address
        j       __loop
        
__add10:
        addi    $t6,    $t6,    10         # add 10 to accum
        addi    $t1,    $t1,    -1         # decrement counter
                                           # we should be at end, so we wont loop
__calcmod:
        bne     $t1,    $zero,    __exitfail  # fail if we haven't counted 10
        addi    $t1,    $t1,    11
        div     $t6,    $t1
        mfhi    $v0                        # $v0 holds remainder
        slti    $v0,    $v0,    1          # (accum % 11) == 0 ? 1 : 0
        j       __done

__exitfail:
        addi    $v0,    $zero,   0         # fail with 0 for tests

__done:
        jr $ra

