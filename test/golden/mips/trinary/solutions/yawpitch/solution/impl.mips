#      Return the decimal equivalent of the given trinary string (ie "102101" -> 307).

.globl trinary_convert

#      $a0 - argument for input string, as starting address
#      $v0 - result,                    as integer representing the decimal value
#      $t0 - holds the current char's index / points value
#      $t1 - flag to check for input validity
#      $t2 - temporary for tripling

.text

trinary_convert:

	li $v0, 0						# initialize the value accumulator
		
	next:
		lb $t0, 0($a0)				# load the next char
		beq		$t0, $zero, end		# if it is NULL, go to end

		subi	$t0, $t0, '0'		# set "0"-"2" to 0-2
	 	slti	$t1, $t0, 3			# sets the flag to 1 for valid, 0 for invalid
		mul		$t0, $t0, $t1		# sets invalid inputs to 0

		sll		$t2, $v0, 1			# double the accumulator with a left shift
		addu	$v0, $t2, $v0		# then add the accumulator to its double to triple
		add		$v0, $v0, $t0		# and add the points value to the accumulator

		addi	$a0, $a0, 1			# increment the address
		j next
	
	end:
		jr $ra