.globl binary_convert

.data
zero: .word 48
newline: .asciiz "\n"
result: .asciiz " -> "

.text

binary_convert:
        move     $t1, $a0
        li       $v0, 4                  # 4 is print string
        syscall
        la       $a0, newline
        syscall
        move     $a0, $t1

        move $t3, $a0
        li $t1, 1
        addi $a0, $a0, 1
loop1:  
        lb $t2, 0($a0)       
        beq $t2, $zero, start
        addi $a0, $a0, 1
        sll $t1, $t1, 1
        j loop1

start:
        move $a0, $t3
        li $v0, 0

loop:   
        lb $t2, 0($a0)        # read next character in t2
        beq $t2, $zero, end   # exit if (t2)=0

        li $t3, 48
        sub $t2, $t2, $t3

        beq $t2, $zero, next 
        add $v0, $v0, $t1
next:
        addi $a0, $a0, 1
        srl $t1, $t1, 1
        j loop
        
end:
        jr $ra
