# | Register | Usage     | Type    | Purpose                    |
# | -------- | --------- | ------- | -------------------------- |
# | `$a0`    | input     | integer | given value                |
# | `$v0`    | output    | integer | difference of squares      |
# | `$t0-9`  | temporary | any     | used for temporary storage |

.globl difference_of_squares


difference_of_squares:
        
        move $t0, $zero
        move $t1, $zero
        move $t2, $a0
        addi $t2, $t2,1
loop_start:
        bge $t0, $t2, loop_end
        mul $t3, $t0, $t0
        add $t1, $t1, $t3
        
        addi $t0, $t0, 1
        j loop_start
loop_end:
        move $t4, $t1
        li $t0, 0
        li $t1, 0
        move $t2, $a0
        addi $t2,$t2,1
loop1_start:
        bge $t0, $t2, loop1_end
        add $t1, $t1, $t0
        
        addi $t0, $t0, 1
        j loop1_start
loop1_end:
        mul $t1, $t1, $t1
        sub $v0, $t1,$t4
        jr $ra