.globl difference_of_squares

.text

difference_of_squares:
# set up
    addi    $t9, $a0, 1        # n + 1
    add     $t8, $a0, $t9      # 2*n + 1

# square of sum
    mul     $t0, $a0, $t9      # n * (n + 1)
    div     $t0, $t0, 2        # n * (n + 1) / 2
    mul     $t1, $t0, $t0      # sum squared

# sum of squares
    mul     $t0, $t0, $t8      # n * (n + 1) * (2*n + 1) / 2  
    div     $t0, $t0, 3        # n * (n + 1) * (2*n + 1) / 6

# diff of squres
    sub    $v0, $t1, $t0       # subtract two previous results
    jr     $ra                 # return