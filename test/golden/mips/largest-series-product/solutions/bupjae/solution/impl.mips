# | Register | Usage        | Type    | Description                   |
# | -------- | ------------ | ------- | ----------------------------- |
# | `$a0`    | input        | address | null-terminated digits string |
# | `$a1`    | input        | integer | span                          |
# | `$v0`    | output       | integer | largest series product        |
# | `$t0-9`  | temporary    | any     | for temporary storage         |

.globl largest_product

largest_product:
        beqz $a1, _bailout
        bltz $a1, _error

        li $a2, 0
        move $t0, $a0
_length:
        lb $t1, ($t0)
        addi $t0, $t0, 1
        addi $a2, $a2, 1
        beqz $t1, _length_done
        addi $t1, $t1, -48
        sltiu $t1, $t1, 10
        bnez $t1, _length
_error:
        li $v0, -1
        jr $ra

_length_done:
        sub $a2, $a2, $a1
        blez $a2, _error
        li $v0, 0

_loop1:
        li $v1, 1
        move $t0, $a0
        move $t2, $a1

_loop2:
        lb $t1, ($t0)
        addi $t0, $t0, 1
        addi $t2, $t2, -1
        addi $t1, $t1, -48
        mul $v1, $v1, $t1
        bgtz $t2, _loop2

        bge $v0, $v1, _skip
        move $v0, $v1
_skip:
        addi $a2, $a2, -1
        addi $a0, $a0, 1
        bgtz $a2, _loop1
        jr $ra

_bailout:
        li $v0, 1
        jr $ra

