.globl egg_count

.text
# v0 return value
# t0 store and operate on the argument
# t1 flag that records if lsb is 1 or 0
# t2 iteration variable
# t3 bitmask to isolate lsb

egg_count:

#set up
    li     $v0, 0               # reset return
    add    $t0, $zero, $a0      # set t0 to argument
    li     $t1, 0               # reset t1
    li     $t2, 32              # set t2 to size of register
    li     $t3, 1               # set t3 to bitmask

loop:
    addi   $t2, $t2, -1         # decrement iteration variable
    beqz   $t2, return          # return if iteration finished
    and    $t1, $t0, $t3        # store lsb into t1
    srl    $t0, $t0, 2          # shift bits to the right (discard lsb)
    beqz   $t1, loop            # don't increase return value if lsb is zero
    addi   $v0, $v0, 1          # increase return value if lsb is one
    j      loop                 # loop after increasing
 
return:
    jr    $ra                   # return after loop is done