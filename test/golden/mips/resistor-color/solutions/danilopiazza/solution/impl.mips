# | Register | Usage     | Type    | Description                     |
# | -------- | --------- | ------- | ------------------------------- |
# | `$a0`    | input     | address | color as null-terminated string |
# | `$v0`    | input     | integer | resistor value                  |
# | `$t0-9`  | temporary | any     | for temporary storage           |

.data

color_black: .asciiz "black"
color_brown: .asciiz "brown"
color_red: .asciiz "red"
color_orange: .asciiz "orange"
color_yellow: .asciiz "yellow"
color_green: .asciiz "green"
color_blue: .asciiz "blue"
color_violet: .asciiz "violet"
color_grey: .asciiz "grey"
color_white: .asciiz "white"

colors_array: .word color_black, color_brown, color_red, color_orange, color_yellow, color_green, color_blue, color_violet, color_grey, color_white, 0

.text

.globl color_code

color_code:
        sw $ra, ($sp)
        addi $sp, $sp, -4
        # $t4 = $a0
        move $t4, $a0
        # $t5 = 0
        move $t5, $zero
        # $t6 = colors_array
        la $t6, colors_array
color_code_loop:
        # while (strcmp($a0, colors_array[$t5]))
        move $a0, $t4
        sll $t0, $t5, 2
        add $t0, $t0, $t6
        lw $a1, ($t0)
        jal strcmp
        beq $v0, $zero, color_code_end
        # $t5++
        addi $t5, $t5, 1
        j color_code_loop
color_code_end:
        # return $t5
        move $v0, $t5
        addi $sp, $sp, 4
        lw $ra, ($sp)
        jr $ra

strcmp:
        # $v0 = 0
        move $v0, $zero
strcmp_loop:
        # while (!$v0)
        bne $v0, $zero, strcmp_end
        # $v0 = *$a0 - $a1
        lbu $t0, ($a0)
        lbu $t1, ($a1)
        sub $v0, $t0, $t1
        # if (!*$a0 || !*$a1) break
        beq $t0, $zero, strcmp_end
        beq $t1, $zero, strcmp_end
        # $a0++, $a1++
        addi $a0, $a0, 1
        addi $a1, $a1, 1
        j strcmp_loop
strcmp_end:
        # return $v0
        jr $ra
