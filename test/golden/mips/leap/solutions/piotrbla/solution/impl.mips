.globl is_leap_year

is_leap_year:
        li      $v0, 0                  # Reset accumulator to 0.
        move      $t1, $a0             # Load a value

        andi    $t0,$t1,0x3
        bne     $t0,$0, Leap1
        li      $v0, 1
Leap1:
	li	$t2, 100		#year % 100
	div	$t0, $t1, $t2
	mfhi	$t3
	bne	$t3, $0, Leap2
	li	$v0, 0
Leap2:
	li	$t2, 400		#year % 400
	div	$t0, $t1, $t2
	mfhi	$t3
	bne	$t3, $0, end
	li	$v0, 1
end:
        jr $ra