## Registers

# | Register | Usage     | Type    | Description                                      |
# | -------- | --------- | ------- | ------------------------------------------------ |
# | `$a0`    | input     | integer | year to check                                    |
# | `$v0`    | output    | boolean | input is leap year (`0` = `false`, `1` = `true`) |
# | `$t0-9`  | temporary | any     | used for temporary storage                       |

.globl is_leap_year

is_leap_year:
  # Step 1: Check if year is positive (greater than zero)
  bltz $a0, error  # Branch on less than zero to error handling

  # Step 2: Check if divisible by 4
  addi $t0, $a0, 0      # Move year to temporary register
  div $t0, $t0, 4       # Divide year by 4
  mfhi $t1              # Move remainder to $t1
  beqz $t1, step3      # Branch on zero remainder (divisible by 4) to step 3

  # Not divisible by 4, return false
  addi $v0, $zero, 0     # Set $v0 to false (0)
  jr $ra                # Return

step3:
  # Step 3: Check if divisible by 100
  addi $t0, $a0, 0      # Move year back to temporary register
  div $t0, $t0, 100     # Divide year by 100
  mfhi $t1              # Move remainder to $t1
  beqz $t1, step4      # Branch on zero remainder (divisible by 100) to step 4

  # Not divisible by 100, return true
  addi $v0, $zero, 1     # Set $v0 to true (1)
  jr $ra                # Return

step4:
  # Check if also divisible by 400
  addi $t0, $a0, 0      # Move year back to temporary register
  div $t0, $t0, 400     # Divide year by 400
  mfhi $t1              # Move remainder to $t1
  beqz $t1, leap_year   # Branch on zero remainder (divisible by 400) to leap year

  # Not divisible by 400, return false
  addi $v0, $zero, 0     # Set $v0 to false (0)
  jr $ra                # Return

leap_year:
  # Divisible by 400, return true
  addi $v0, $zero, 1     # Set $v0 to true (1)
  jr $ra                # Return

error:
  # Error handling (replace with your desired error handling code)
  li $v0, 10            # Set $v0 to error code (example)
  jr $ra                # Return

# End of program
