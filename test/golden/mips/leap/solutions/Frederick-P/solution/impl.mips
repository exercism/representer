## Registers

# | Register | Usage     | Type    | Description                                      |
# | -------- | --------- | ------- | ------------------------------------------------ |
# | `$a0`    | input     | integer | year to check                                    |
# | `$v0`    | output    | boolean | input is leap year (`0` = `false`, `1` = `true`) |
# | `$t0-9`  | temporary | any     | used for temporary storage                       |

# 240116 (copied from youtube https://www.youtube.com/watch?v=Fj5m16is5hI) - ErikSchierboom's solution

.globl is_leap_year

is_leap_year:

#       jr $ra
#        rem    $t0, $a0, 4
#        bnez   $t0, __false
#        rem    $t0, $a0, 400
#        beqz   $t0, __true
#        rem    $t0, $a0, 100
#        beqz   $t0, __false

        rem    $t0, $a0, 100
        beqz   $t0, __century
        rem    $t0, $a0, 4
        beqz   $t0, __true
__century: 
        rem $t0, $a0, 400
        bnez $t0, __false   
__true:
        li     $v0, 1
        j      __return
__false:
        li     $v0, 0
__return:
        jr     $ra

