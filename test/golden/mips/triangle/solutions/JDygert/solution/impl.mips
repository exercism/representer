.text

.globl triangle

triangle:
    # Sort largest into $a2

    ble $a0 $a1 b0
        # Swap $a0 with $a1
        xor $a0, $a0, $a1
        xor $a1, $a0, $a1
        xor $a0, $a0, $a1
    b0:

    ble $a1 $a2 b1
        # Swap $a1 with $a2
        xor $a1, $a1, $a2
        xor $a2, $a1, $a2
        xor $a1, $a1, $a2
    b1:


    # Invalid: if a + b <= c
    add $t0, $a0, $a1
    ble $t0, $a2, invalid

    seq $t0, $a0, $a1
    seq $t1, $a1, $a2

    # Equilateral: if a == b && b == c
    and $t2, $t0, $t1
    beq $t2, 1, equilateral

    # Isoceles: else if a == b || b == c
    or $t2, $t0, $t1
    beq $t2, 1, isoceles

    # Scalene: else
    scalene:
        li $v0, 0
        jr $ra

    isoceles:
        li $v0, 1
        jr $ra

    equilateral:
        li $v0, 2
        jr $ra

    invalid:
        li $v0, 3
        jr $ra
