# | Register | Usage     | Type    | Description                |
# | -------- | --------- | ------- | -------------------------- |
# | `$a0`    | input     | integer | x                          |
# | `$a1`    | input     | integer | y                          |
# | `$v0`    | output    | integer | points earned              |
# | `$t0-9`  | temporary | any     | used for temporary storage |

.globl score

score:
    move $v0, $zero
    li $t9, 1
    mul $t0, $a0, $a0
    mul $t1, $a1, $a1
    add $t3, $t0, $t1
    slti $t4, $t3, 2
    beq $t4, $t9, if_inner_circle
    slti $t4, $t3, 26
    beq $t4, $t9, if_middle_circle
    slti $t4, $t3, 102
    beq $t4, $t9, if_outer_circle
    j exit
if_inner_circle:
    addi $v0, $zero, 10
    j exit
if_middle_circle:
    addi $v0, $zero, 5
    j exit
if_outer_circle:
    addi $v0, $zero, 1
    j exit
exit:
    jr $ra