# | Register | Usage     | Type    | Description                |
# | -------- | --------- | ------- | -------------------------- |
# | `$a0`    | input     | integer | x                          |
# | `$a1`    | input     | integer | y                          |
# | `$v0`    | output    | integer | points earned              |
# | `$t0-9`  | temporary | any     | used for temporary storage |

.globl score

.eqv x $a0
.eqv y $a1
.eqv points $v0
.eqv x2 $t0
.eqv y2 $t1
.eqv len2 $t2

score:
	mul x2, x, x
	mul y2, y, y
	add len2, x2, y2
	li points, 0
	bgt len2, 100, return
	li points, 2
	bgt len2, 25, return
	li points, 5
	bgt len2, 1, return
	li points, 10
return:
	jr $ra