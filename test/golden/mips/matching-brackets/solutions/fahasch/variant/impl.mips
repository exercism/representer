# | Register | Usage     | Type    | Description                                               |
# | -------- | --------- | ------- | --------------------------------------------------------- |
# | `$a0`    | input     | address | null-terminated input string                              |
# | `$v0`    | output    | boolean | input has matching brackets (`0` = `false`, `1` = `true`) |
# | `$t0-9`  | temporary | any     | used for temporary storage                                |

.globl is_paired

# stack for saving type of opening brackets
.data
stack: .space 100
.text

# registers
.eqv input $t0          # pointer to input string
.eqv top   $t1          # pointer to top of stack
.eqv ch    $t2          # char being parsed
.eqv temp  $t9

# type of brackets
.eqv paren 0      # (
.eqv brack 2      # [
.eqv brace 2      # {

.macro push(%type)
        li temp, %type
        sb temp, (top)
        addiu top, top, 1
.end_macro

.macro pop(%ret)
        la temp, stack
        beq top, temp, __fail
        addi top, top, -1
        lb %ret, (top)
.end_macro

.macro close(%type)                # check if %type can be closed
       pop(temp)
       bne temp, %type, __fail
.end_macro


is_paired:
        move input, $a0
        la top, stack

__next:
        lb ch, (input)
        addiu input, input, 1
        beqz ch, __end

        # check opening
__o_p:
        bne ch, '(', __o_bk
        push(paren)
        j __next

__o_bk:
        bne ch, '[', __o_bc
        push(brack)
        j __next

__o_bc:
        bne ch, '{', __c_p
        push(brace)
        j __next

        # check closing
__c_p:
        bne ch, ')', __c_bk
        close(paren)
        j __next

__c_bk:
        bne ch, ']', __c_bc
        close(brack)
        j __next

__c_bc:
        bne ch, '}', __next
        close(brace)
        j __next

__end:
        la temp, stack
        seq $v0, top, temp
        jr $ra

__fail:
        li $v0, 0
        jr $ra