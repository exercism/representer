.data

invalid_na_msg: .asciiz "Not a valid nucleic acid character: "

.text
.globl transcribe_rna

transcribe_rna:
    #move    $v0     $zero
    move    $v1     $a1
    addi    $t3     $zero       'U'
    addi    $t4     $zero       'G'
    addi    $t5     $zero       'C'
    addi    $t6     $zero       'T'
    addi    $t7     $zero       'A'
loop:
    lb      $t0     0($a0)
    #lb      $t1     0($a1)
    addi    $a0     $a0         1
    #addi    $a1     $a1         1
    beq     $t0     $zero       break
    beq     $t0     $t4         transcribeG
    beq     $t0     $t5         transcribeC
    beq     $t0     $t6         transcribeT
    beq     $t0     $t7         transcribeA
    j       invalid
transcribeG:
    sb      $t5     0($a1)
    addi    $a1     $a1         1
    j       loop  
transcribeC:
    sb      $t4     0($a1)
    addi    $a1     $a1         1
    j       loop  
transcribeT:
    sb      $t7     0($a1)
    addi    $a1     $a1         1
    j       loop  
transcribeA:
    sb      $t3     0($a1)
    addi    $a1     $a1         1
    j       loop  
break:
    sb      $zero  0($a1)
    move    $a1     $v1         #1
    jr  $ra
invalid:
    la      $a0     invalid_na_msg
    addi    $v0     $zero   4
    syscall
    move    $a0, $t0                # print input char that failed on
    li      $v0, 4
    syscall
    la      $a0     1
    addi    $v0     $zero   17
    syscall