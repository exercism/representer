.globl is_isogram

.text

is_isogram:
# set-up
    move    $t0, $a0           # copy input string address
    move    $t1, $zero         # reset t1 register (store seen values)
    move    $v0, $zero         # initialize return value to false
    li      $t9, 1             # constant 1 for operations

__loop:
# read next char
    lb      $t2, ($t0)         # load current char
    beqz    $t2, __true        # reached end of string without finding repeated leters
    addi    $t0, $t0, 1        # increase string pointer

# check lowercase
    sge     $t3, $t2, 'a'      # char <= 'a'
    sle     $t4, $t2, 'z'      # char >= 'z'
    and     $t3, $t3, $t4      # char in 'a'..'z'
    bnez    $t3, __lowercase   # found lowercase letter

# check uppercase
    sge     $t3, $t2, 'A'      # char <= 'A'
    sle     $t4, $t2, 'Z'      # char >= 'Z'
    and     $t3, $t3, $t4      # char in 'A'..'Z'
    bnez    $t3, __uppercase   # found uppercase letter

# any other char
    j       __loop             # continue with next char

__lowercase:
    subi    $t2, $t2, 32       # turn to uppercase

__uppercase:
    subi    $t2, $t2, 'A'      # get alphabet letter count (0-25)
    sllv    $t3, $t9, $t2      # 1 shifted by letter value
    and     $t4, $t3, $t1      # check for letter in seen
    bnez    $t4, __end         # if letter is repeated input is not isogram
    or      $t1, $t1, $t3      # add letter to seen
    j       __loop             # continue with next char

__true:
    move    $v0, $t9           # set return value to true

__end:
    jr      $ra                # return