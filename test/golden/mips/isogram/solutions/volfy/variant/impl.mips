.globl is_isogram


.text

is_isogram:
	or $v0, 1 # set to 1=true by default
	move $t0, $a0
	move $t1, $zero # init bitmask
	
	loop:
	   lb $t2, ($t0) # t2 = inp[i]
	   beqz $t2, returnit
	   
	   blt $t2, 'A', endops # skip ops if space, dash etc
	   nop
	   
	   bge $t2, 'a', lowercase
	   nop
	   
	   # is uppercase
	   sub $t2, $t2, '@' # A = 1, B = 2, ...
	   j bitmasking
	   
	   lowercase:
	     sub $t2, $t2, '`' # a = 1, b = 2, ...
	   
	   bitmasking:
	     li $t3, 1
	     sllv $t3, $t3, $t2 # shift left by t2, 1 times for a/A, 2 for b/B etc
	     
	     and $t4, $t3, $t1 # check if the bit is already set
	     bnez $t4, notaniso
	     nop
	     
	   # not yet set, so set it for next iter
	   or $t1, $t1, $t3
	   
	   endops:
	   addu $t0, $t0, 2 # i++
	   j loop
	
	notaniso:
	  move $v0, $zero
	
	returnit:
	jr $ra