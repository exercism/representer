    # | Register | Usage     | Type    | Description                    |
    # | -------- | --------- | ------- | ------------------------------ |
    # | `$a0`    | input     | address | first, null-terminated, string |
    # | `$a1`    | input     | address | first, null-terminated, string |
    # | `$v0`    | output    | integer | hamming distance               |
    # | `$t0-9`  | temporary | any     | for temporary storage          |

.globl hamming_distance

hamming_distance:

	li	$t0, 0		# index
	li	$v0, 0		# differences

loop:
	# load byte from str0
	add	$t1, $a0, $t0	# ptr0 <- str0 + idx
	lbu	$t2, ($t1)	# char0 <- *ptr0

	# load byte from str1
	add	$t3, $a1, $t0	# ptr1 <- str1 + idx
	lbu	$t4, ($t3)	# char1 <- *ptr1


	beqz	$t2, end_loop
	beqz	$t4, end_loop
	
	sne	$t5, $t2, $t4	# compare the bytes
	add	$v0, $v0, $t5	# incr diffs if different

	addi	$t0, $t0, 1	# incr idx
	j       loop
end_loop:
	jr	$ra		# return
