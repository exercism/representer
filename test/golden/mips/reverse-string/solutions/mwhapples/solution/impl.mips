# | Register | Usage        | Type    | Description                   |
# | -------- | ------------ | ------- | ----------------------------- |
# | `$a0`    | input        | address | null-terminated input string  |
# | `$a1`    | input/output | address | null-terminated output string |
# | `$t0-9`  | temporary    | any     | used for temporary storage    |

.globl reverse

reverse:
        move $t0, $a0
        move $t1, $a1
lenloop:
        lb $t2, 0($t0)
        beq $t2, $zero, reverseloop
        add $t0, $t0, 1
      j lenloop
reverseloop:
        beq $t0, $a0, end
        add $t0, $t0, -1
        lb $t2, 0($t0)
        sb $t2, 0($t1)
        add $t1, $t1, 1
        j reverseloop
end:
        sb $zero, 0($t1)
        jr $ra
