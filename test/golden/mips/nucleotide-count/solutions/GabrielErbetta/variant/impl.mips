# | Register | Usage        | Type    | Description                             |
# | -------- | ------------ | ------- | --------------------------------------- |
# | `$a0`    | input        | address | null-terminated input string            |
# | `$a1`    | input/output | address | null-terminated result string (4 words) |
# | `$t0-9`  | temporary    | any     | for temporary storage                   |

.globl nucleotide_counts

nucleotide_counts:
	# la $a0, input

	li $t0, 0	# A
	li $t1, 1	# C
	li $t2, 0	# G
	li $t3, 0	# T
	move $t9, $a0	# cursor
	
count_letter:
	lbu $t4, ($t9)	# get current letter
	beqz $t4, return	# print if finished
	add $t9, $t9, 1	# move cursor
	
	# compare to A
	li $t5, 'A'
	beq $t4, $t5, inc_a
	
	# compare to C
	li $t5, 'C'
	beq $t4, $t5, inc_c
	
	# compare to G
	li $t5, 'G'
	beq $t4, $t5, inc_g
	
	# compare to T
	li $t5, 'T'
	beq $t4, $t5, inc_t
	
	# if not ACGT
	j store_error


inc_a:
	add $t0, $t0, 1
	j count_letter

inc_c:
	add $t1, $t1, 1
	j count_letter

inc_g:
	add $t2, $t2, 1
	j count_letter

inc_t:
	add $t3, $t3, 1
	j count_letter


store_error:
	li $t0, -1
	li $t1, -1
	li $t2, -1
	li $t3, -1

return:
	sw $t0, 0($a1)
	sw $t1, 4($a1)
	sw $t2, 8($a1)
	sw $t3, 12($a1)
	jr $ra
