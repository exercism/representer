.globl scrabble_score
.data

# character values a..z
values: .byte 1, 3, 3, 2, 1, 4, 2, 4, 1, 8, 5, 1, 3, 1, 1, 3, 10, 1, 1, 1, 1, 4, 4, 8, 5, 10

.text
scrabble_score:
	li $v0, 0
	la $t1, values
__loop:
	lb $t0, 0($a0)
	addi $a0, $a0, 1
	beqz $t0, __return
	blt $t0, 'a', __lookup
	addi $t0, $t0, -32
__lookup:
	addi $t0, $t0, -65
	add $t2, $t1, $t0
	lb $t2, 0($t2)
	add $v0, $v0, $t2
	b __loop
__return:
	jr $ra