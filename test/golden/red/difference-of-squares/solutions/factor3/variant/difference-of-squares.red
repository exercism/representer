Red [
	description: {"Difference of Squares" exercise solution for exercism platform}
	author: "factor3"
]

square-of-sum: function [n][
	n + 1 * n / 2 ** 2
]

sum-of-squares: function [n][
	divide multiply n + 1 * n n + n + 1 6
]

difference-of-squares: function [n][
	absolute divide multiply add n ** 2 * 3 n - n subtract 1 n ** 2 12
]

