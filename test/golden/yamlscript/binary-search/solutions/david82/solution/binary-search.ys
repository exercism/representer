!yamlscript/v0

# Check if array is empty or invalid
defn validateArray(array):
  when array == []:
    die: 'value not in array'

# Calculate middle index
defn getMid(low high):
  (high + low).quot(2)

# Binary search helper function
defn binarySearch(array value low high):
  when low > high:
    die: 'value not in array'
   
  mid =: getMid(low high)
  item =: array.$mid
   
  cond:
    value == item : mid
    value < item  : binarySearch(array value low mid.--)
    else         : binarySearch(array value mid.++ high)

# Main binary search function
defn find(array value):
  validateArray(array)
  binarySearch(array value 0 array.--)
