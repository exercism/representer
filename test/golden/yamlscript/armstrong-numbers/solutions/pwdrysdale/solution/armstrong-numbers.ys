!YS-v0

defn count(number):
    len(str(number))

defn split-digits(number):
    split(str(number))

defn get-digit-powered(d, number):
    (pow (to-int d) count(number))

defn generate-sum(number):
    (reduce + 0 (map (fn [d] (get-digit-powered d number)) (split-digits number)))

defn is-armstrong-number(number):
    (== (generate-sum number) number)