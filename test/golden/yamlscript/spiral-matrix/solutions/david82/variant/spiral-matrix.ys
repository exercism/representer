!yamlscript/v0

defn spiral-matrix:
  (size):
    if size.?: spiral-matrix(1 size size) []
  (start-num width height):
    current-row =: -[range(width).map(add(start-num))]
    if height == 1:
      spiral-matrix((width + start-num) height.-- width):
        .apply(map vector _)
        .map(reverse)
        .concat(current-row _)
      else: current-row
