!YS-v0

defn isPrime(n):
  (n > 1) &&
  \(zero?(n % _))
    .not-any?(range(2 (+ 1 (floor (sqrt n)))))

defn factors(value):
    loop [factors [] divisor 2 val value]:
        cond:
            (== val 1): factors
            (> divisor value) && (== (val % divisor) 0) && isPrime(divisor) : factors + divisor
            (> divisor value) && isPrime(divisor): factors
            (== (val % divisor) 0) && isPrime(divisor): recur((factors + divisor) divisor (/ val divisor))
            :else: recur(factors divisor.++ val)

