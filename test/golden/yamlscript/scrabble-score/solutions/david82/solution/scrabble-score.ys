!yamlscript/v0

# Define letter scores as constants
letterGroups =::
  1: AEIOULNRST
  2: DG
  3: BCMP
  4: FHVWY
  5: K
  8: JX
  10: QZ

# Helper function to create letter-score pairs
defn createLetterScorePairs(score chars):
  zipmap: chars:split repeat(score)

# Helper function to create complete score map
defn createScoreMap():
  reduce _ {} letterGroups:
    fn(acc [score letters]):
      acc + createLetterScorePairs(score letters)

# Main scoring function
defn score(word):
  scores =: createScoreMap()
  =>: uc(word):split.map(scores):sum
