!yamlscript/v0

allergen-map =:
  zipmap _ range()::
  - eggs
  + peanuts
  - shellfish
  - strawberries
  - tomatoes
  - chocolate
  - pollen
  - cats

defn allergic-to(item score):
  bit-test score: allergen-map.$item

defn list-allergens(score):
  valid-score =: bit-and(score 255)
  keep _ allergen-map:
    fn([allergen num]):
      bit-test(valid-score num) &&& allergen
