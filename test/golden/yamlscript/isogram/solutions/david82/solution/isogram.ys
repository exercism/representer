!yamlscript/v0

defn isogram(phrase):
  # Convert to lowercase and filter out hyphens and spaces using string methods
  cleaned =: lc(phrase).replace("-", "").replace(" ", "")
  
  # Convert string to array of characters
  chars =: cleaned.split("")
  
  # Create a set from characters to remove duplicates
  unique =: set(chars)
  
  # Compare lengths - if they're equal, there were no duplicates
  =>: len(chars) == len(unique)
