!yamlscript/v0

defn keep(list predicate):
  loop [result [] remaining list]:
    cond:
      empty?(remaining): result
      predicate(first(remaining)): 
        recur(conj(result first(remaining)) rest(remaining))
      else: 
        recur(result rest(remaining))

defn discard(list predicate):
  loop [result [] remaining list]:
    cond:
      empty?(remaining): result
      predicate(first(remaining)): 
        recur(result rest(remaining))
      else:
        recur(conj(result first(remaining)) rest(remaining))
