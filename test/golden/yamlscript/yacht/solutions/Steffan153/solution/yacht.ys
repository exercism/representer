!yamlscript/v0

defn score(dice category):
  dice-set =: dice:distinct:sort
  counts =: dice:frequencies
  counts2 =: counts:set/map-invert
  case category:
    -'yacht': if((dice-set.# == 1) 50 0)
    -'choice': dice:sum
    -'little straight': if((dice-set == [1 2 3 4 5]) 30 0)
    -'big straight': if((dice-set == [2 3 4 5 6]) 30 0)
    -'four of a kind': counts2(4 counts2(5 0)) * 4
    -'full house': if((counts2.2 && counts2.3) dice:sum 0)
    -'ones': counts(1 0) * 1
    -'twos': counts(2 0) * 2
    -'threes': counts(3 0) * 3
    -'fours': counts(4 0) * 4
    -'fives': counts(5 0) * 5
    -'sixes': counts(6 0) * 6