!yamlscript/v0

defn annotate(minefield):
  map-indexed _ minefield:
    fn(row-idx row):
      apply str _:
        map-indexed _ row:
          fn(col-idx col):
            c =:
              count _:
                for x [-1 0 1], y [-1 0 1], :when minefield.get(row-idx + x).get(col-idx + y).eq(\\*): 1
            cond:
              col == \\*: \\*
              c == 0: \\space
              else: \\0 + c
