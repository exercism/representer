!yamlscript/v0

defn classify(number):
  when number <= 1:
    die: 'Classification is only possible for positive integers.'
  s =:
    reduce _ 0 range(1 (quot number 2).++):
      fn(a x):
        if (number % x).!:
          (a + x)
          a
  cond:
    s == number: 'perfect'
    s < number: 'deficient'
    else: 'abundant'
