!yamlscript/v0

defn classify(number):
  when number < 1:
    die: 'Classification is only possible for positive integers.'
    
  aliquot-sum =:
    reduce _ 0 range(1 (quot number 2).++):
      fn(sum factor):
        if (number % factor).!:
          (sum + factor)
          sum
          
  cond:
    aliquot-sum == number: 'perfect'
    aliquot-sum < number: 'deficient'
    else: 'abundant'
