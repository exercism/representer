!YS-v0

defn classify(number):
  when number < 1: die('Classification is only possible for positive integers.')
  a =: aliquot(number)
  cond:
    a < number: 'deficient'
    a > number: 'abundant'
    else: 'perfect'

defn aliquot(number):
  (range 1 (number / 2):floor.++): .filter(\((number % _):zero?)):sum
