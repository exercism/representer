!YS-v0

defn isPrime?(num):
   cond:
      (< num 2): false
      (== num 2): true
      (== num 3): true
      (even? num): false
      :else:
         loop [i 3]:
            cond:
               (mod num i).!: false
               (< num (* i i)): true
               :else: (recur (+ i 2))

defn prime(n):
   cond:
      (== n 1): 2
      :else:
         loop [nth 2 check 3]:
            cond:
               (isPrime? check):
                  if (== nth n): check (recur (inc nth) (+ check 2))
               :else: (recur nth (+ check 2))
