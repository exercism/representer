(module
    (memory (export "mem") 1)
    (func $is_lower (param i32) (result i32)
        (i32.and (i32.le_u (i32.const 97) (local.get 0))
            (i32.le_u (local.get 0) (i32.const 122)))
    )
    (func $is_upper (param i32) (result i32)
        (i32.and (i32.le_u (i32.const 65) (local.get 0))
            (i32.le_u (local.get 0) (i32.const 90)))
    )
    (func $rot (param $c i32) (param $n i32) (result i32)
        (if (call $is_lower (local.get $c))
            (then (local.set $c (i32.sub (local.get $c) (i32.const 97)))
                (local.set $c (i32.rem_u (i32.add (local.get $c) (local.get $n)) (i32.const 26)))
                (local.set $c (i32.add (local.get $c) (i32.const 97)))))
        (if (call $is_upper (local.get $c))
            (then (local.set $c (i32.sub (local.get $c) (i32.const 65)))
                (local.set $c (i32.rem_u (i32.add (local.get $c) (local.get $n)) (i32.const 26)))
                (local.set $c (i32.add (local.get $c) (i32.const 65)))))
        (local.get $c)
    )

    (func (export "rotate") (param $textOffset i32) (param $textLength i32) (param $shiftKey i32) (result i32 i32)
        (local $begin i32)
        (local $end i32)
        (local.set $begin (local.get $textOffset))
        (local.set $end (i32.add (local.get $begin) (local.get $textLength)))
        (block $break (loop $continue
            (br_if $break (i32.ge_u (local.get $begin) (local.get $end)))
            (i32.store8 (local.get $begin)
                (call $rot (i32.load8_u (local.get $begin)) (local.get $shiftKey)))
            (local.set $begin (i32.add (local.get $begin) (i32.const 1)))
            (br $continue)
        ))
        (return (local.get $textOffset) (local.get $textLength))
    )
)
