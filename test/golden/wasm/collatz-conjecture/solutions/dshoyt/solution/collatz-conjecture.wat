(module
  (func $steps (export "steps") (param $number i32) (result i32)
    (if (i32.le_s (local.get $number)(i32.const 0))
      (then (return (i32.const -1)))
      (else (if (i32.eq (local.get $number)(i32.const 1))(then (return (i32.const 0)))))
    )
    (if (i32.eq (i32.rem_u (local.get $number)(i32.const 2))(i32.const 0))
      (then (return (i32.add (i32.const 1)(call $steps (i32.div_u (local.get $number)(i32.const 2))))))
      (else (return (i32.add (i32.const 1)(call $steps (i32.add (i32.const 1)(i32.mul (local.get $number)(i32.const 3)))))))
    )
    (return (i32.const -1))
  )
)