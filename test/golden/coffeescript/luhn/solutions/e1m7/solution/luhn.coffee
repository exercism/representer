# 1) функция doubleOddPositions (удвоение числа)
# 2) получает на вход два числа: n = цифра, i = индекс цифры
# 3) если позиция нечетная, то возвращаем удвоенную цифру
# 4) если позиция четная, то возвращаем саму цифру

doubleOddPositions = (n, i) ->
  if i % 2 == 1
    return n * 2
  return n

# 1) функция корректировки числа
# 2) получает на вход число n
# 3) если n > 9, то возвращает n - 9
# 4) если n <= 9, то возвращает n

subNineIfNeeded = (n) ->
  if n > 9
    return n - 9
  return n

# 1) функция add (сложение двух чисел)
# 2) получает a, b и возвращает a + b

add = (a, b) -> a + b

# 1) создание экземпляра класса @_valid
# 2) на вход приходит строка, например '234 567 891 234'
# 3) num = замена всех пробелов на пустоту '234567891234'
# 4) вернуть false, если длина строки получилась <= 1 (длина не подходит)
# 5) в остальных случах применить каскад функций к строке
# 6) split('') = разбить строку на символы 2-3-4-5-6-7-8-9-1-2-3-4
# 7) reverse() = перевернуть 4-3-2-1-9-8-6-5-4-3-2
# 8) map(Number) = пропустить через мапу (из символа => число)
# 9) map(doubleOddPositions) = пропустить через мапу (удваивание чентых цифр)
# 10) map(subNineIfNeeded) = пропустить через мапу (вычесть 9, если число больше 9)
# 11) применить функцию add (сложить все)
# 12) вернуть true, если получилось число % 10 без остатка
# 13) вернуть false, если получилось число не % 10 без остатка

class Luhn
    constructor: (num) ->
      num = num.replace(/\s/g, '')
      if num.length <= 1
        @_valid = false
      else
        @_valid = num.split('')
                     .reverse()
                     .map(Number)
                     .map(doubleOddPositions)
                     .map(subNineIfNeeded)
                     .reduce(add) % 10 == 0

    valid: -> @_valid

module.exports = Luhn