(import (rnrs))

(define (rail-index rails)
  (let loop ([i (if (= rails 1) 0 (+ rails rails -3))] [r '()])
    (if (negative? i)
        (list->vector r)
        (loop (- i 1) (cons (if (< i rails) i (+ rails rails -2 (- i))) r)))))

(define (encode rails msg)
  (define n (string-length msg))
  (define r (make-vector rails '()))
  (define index (rail-index rails))
  (define m (vector-length index))
  (let loop ([i 0])
    (unless (= i n)
      (let ([j (vector-ref index (mod i m))])
        (vector-set! r j (cons (string-ref msg i) (vector-ref r j))))
      (loop (+ i 1))))
  (let loop ([i (- rails 1)] [s '()])
    (if (negative? i)
        (apply string-append s)
        (loop (- i 1) (cons (list->string (reverse (vector-ref r i))) s)))))

(define (decode rails msg)
  (define n (string-length msg))
  (define index (rail-index rails))
  (define m (vector-length index))
  (define-values (n1 n2) (div-and-mod n m))
  (define a (make-vector rails 0))
  (define b (make-vector rails))

  (let loop ([i (- m 1)])
    (unless (negative? i)
      (let ([j (vector-ref index i)]) (vector-set! a j (+ (vector-ref a j) n1)))
      (loop (- i 1))))
  (let loop ([i (- n2 1)])
    (unless (negative? i)
      (let ([j (vector-ref index i)]) (vector-set! a j (+ (vector-ref a j) 1)))
      (loop (- i 1))))
  (let loop ([i n] [j (- rails 1)])
    (unless (negative? j)
      (let ([k (vector-ref a j)])
        (vector-set! b j (substring msg (- i k) i))
        (loop (- i k) (- j 1)))))
  (let loop ([i (- n 1)] [r '()])
    (if (negative? i)
        (list->string r)
        (let* ([j (vector-ref index (mod i m))] [k (- (vector-ref a j) 1)])
          (vector-set! a j k)
          (loop (- i 1) (cons (string-ref (vector-ref b j) k) r))))))