(import (rnrs))

(define (acronymable? test-list i)
  (and (char-alphabetic? (list-ref test-list i))
       (or (zero? i)
           (char=? #\space (list-ref test-list (- i 1)))
           (char=? #\- (list-ref test-list (- i 1)))
           (char=? #\_ (list-ref test-list (- i 1))))))

(define (acronym test)
  (let* ((test-list (string->list test))
         (raw-acro-list (do ((i 0 (1+ i))
                             (acro (list) (if (acronymable? test-list i)
                                              (cons (list-ref test-list i) acro)
                                              acro)))
                            ((= i (1- (length test-list))) (reverse acro)))))
    (string-upcase (list->string raw-acro-list))))
