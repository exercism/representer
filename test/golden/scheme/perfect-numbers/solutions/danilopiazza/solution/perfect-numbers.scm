(import (rnrs))

(define (classify n)
  (define (divides? d n)
    (if (= d 0) #f 
        (= (remainder n d) 0)))
  (define (1-to-sqrt n)
    (let-values ([(root rem) (exact-integer-sqrt n)])
      (map 1+ (iota root))))
  (define (divisors-up-to-sqrt n)
    (filter (lambda (d) (divides? d n))
            (1-to-sqrt n)))
  (define (distinct-divisor-and-quotient d n)
    (let ([q (/ n d)])
      (if (= q d) (list d) (list d q))))
  (define (divisors n)
    (fold-right append '()
                (map (lambda (d) (distinct-divisor-and-quotient d n))
                     (divisors-up-to-sqrt n))))
  (define (proper-divisors n)
    (filter (lambda (x) (not (= x n))) (divisors n)))
  (define (aliquot-sum n)
    (fold-right + 0 (proper-divisors n)))
  (if (not (positive? n))
      (error "classify" "n must be a positive integer")
      (let ([sum (aliquot-sum n)])
        (cond [(= sum n) 'perfect]
              [(> sum n) 'abundant]
              [(< sum n) 'deficient]))))

