       IDENTIFICATION DIVISION.
       PROGRAM-ID. CIRCULAR-BUFFER.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CAPACITY              PIC 999.
       01 WS-ITEM                  PIC 9.
       01 WS-RESULT                PIC 9.
       01 WS-SUCCESS               PIC 9.
       01 WS-BUFFER.
          02 WS-CIRCULAR-BUFFER       OCCURS 1 TO 999 TIMES DEPENDING ON WS-CAPACITY PIC S9.
       01 WS-WRITE-INDEX           PIC 9.
       01 WS-READ-INDEX           PIC 9.
       01 WS-LAST-INSERT-INDEX    PIC 9.
       01 WS-CLEAR-INDEX          PIC 9.

       PROCEDURE DIVISION. 
       CREATE-BUFFER.
         MOVE ZEROS TO WS-BUFFER
         MOVE 1 TO WS-WRITE-INDEX
         MOVE 1 TO WS-READ-INDEX
         MOVE 1 TO WS-SUCCESS.
      
       READ-BUFFER.
         IF WS-READ-INDEX > WS-CAPACITY
            MOVE 1 TO WS-READ-INDEX
         END-IF
         DISPLAY WS-CIRCULAR-BUFFER(WS-READ-INDEX)
         MOVE WS-CIRCULAR-BUFFER(WS-READ-INDEX) TO WS-RESULT
         MOVE 0 TO WS-CIRCULAR-BUFFER(WS-READ-INDEX)
         ADD 1 TO WS-READ-INDEX
         IF WS-RESULT = 0 
            MOVE 0 TO WS-SUCCESS
         ELSE
            MOVE 1 TO WS-SUCCESS
         END-IF
         DISPLAY WS-RESULT.

       WRITE-BUFFER.
         IF WS-WRITE-INDEX > WS-CAPACITY
            MOVE 1 TO WS-WRITE-INDEX
         END-IF
         IF WS-CIRCULAR-BUFFER(WS-WRITE-INDEX) = 0
            MOVE WS-ITEM TO WS-CIRCULAR-BUFFER(WS-WRITE-INDEX)
            ADD 1 TO WS-WRITE-INDEX
            MOVE 1 TO WS-SUCCESS
         ELSE
            MOVE 0 TO WS-SUCCESS
         END-IF.

       OVERWRITE-BUFFER.
         IF WS-WRITE-INDEX > WS-CAPACITY
            MOVE 1 TO WS-WRITE-INDEX
         END-IF
         IF WS-CIRCULAR-BUFFER(WS-WRITE-INDEX) = 0
            MOVE WS-ITEM TO WS-CIRCULAR-BUFFER(WS-WRITE-INDEX)
            ADD 1 TO WS-WRITE-INDEX
         ELSE
            MOVE WS-ITEM TO WS-CIRCULAR-BUFFER(WS-READ-INDEX)
            ADD 1 TO WS-READ-INDEX
         END-IF
         PERFORM VARYING WS-CLEAR-INDEX FROM 0 BY 1 UNTIL WS-CLEAR-INDEX > WS-CAPACITY
            DISPLAY WS-CIRCULAR-BUFFER(WS-CLEAR-INDEX)
         END-PERFORM.
         MOVE 1 TO WS-SUCCESS.

       CLEAR-BUFFER.
         PERFORM CREATE-BUFFER.