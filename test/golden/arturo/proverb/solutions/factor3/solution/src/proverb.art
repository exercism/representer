recite: function [strings][
    when [
        empty? strings -> ""
        one? strings -> ~"And all for the want of a |strings\0|."
        any [
            strings | chop
                    | couple drop strings
                    | fold.seed: "" [acc pair] ->
                        acc ++ ~"For want of a |pair\0| the |pair\1| was lost.\n"
                    | append recite take strings 1
        ]
    ]
]