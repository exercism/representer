recite: function [strings][
    if empty? strings [return ""]
    if one? strings [return ~"And all for the want of a |first strings|."]
    
    ; Create pairs of consecutive words
    pairs: map 0..dec dec size strings 'i -> 
        @[strings\[i] strings\[i+1]]
    
    ; Generate main lines using pairs
    mainLines: map pairs 'p ->
        ~"For want of a |first p| the |last p| was lost."
    
    ; Join all lines with newlines and add final line
    join.with:"\n" @[
        join.with:"\n" mainLines
        ~"And all for the want of a |first strings|."
    ]
]
