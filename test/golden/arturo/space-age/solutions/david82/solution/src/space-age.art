; Define orbital periods relative to Earth years
periods: #[
    mercury: 0.2408467
    venus: 0.61519726
    earth: 1.0
    mars: 1.8808158
    jupiter: 11.862615
    saturn: 29.447498
    uranus: 84.016846
    neptune: 164.79132
]

; Calculate age on a planet
ageOn: function [planet :literal seconds :quantity][
    ; Check if planet exists in periods (case-insensitive)
    planetKey: lower to :string planet
    
    if? contains? keys periods planetKey [
        ; Earth year in seconds
        earthYearInSeconds: 31557600
        
        ; Convert seconds to Earth years, then to planet years
        earthYears: to :floating seconds / earthYearInSeconds
        to :floating earthYears / periods\[planetKey]
    ]
    else [
        null
    ]
]
