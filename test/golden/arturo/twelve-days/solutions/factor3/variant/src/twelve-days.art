ordinals: [first second third fourth fifth sixth seventh eighth ninth tenth eleventh twelfth]
items: [
    "a Partridge in a Pear Tree"
    "two Turtle Doves"
    "three French Hens"
    "four Calling Birds"
    "five Gold Rings"
    "six Geese-a-Laying"
    "seven Swans-a-Swimming"
    "eight Maids-a-Milking"
    "nine Ladies Dancing"
    "ten Lords-a-Leaping"
    "eleven Pipers Piping"
    "twelve Drummers Drumming"
]

list: $[items][
    if one? items -> return items\1
    (join.with: ", " chop items) ++ ", and " ++ last items
]

verse: function [n][
    ~"On the |ordinals\[n-1]| day of Christmas my true love gave to me: " ++ (list items\[(n-1)..0]) ++ "."
]

recite: function [start end][
    join.with: "\n" map start..end => verse
]