triangle?: $[x y z][
    all? @[
		z < x + y
		y < x + z
		x < y - z
	]
]

equilateral?: function [x y z][
    all? @[
        triangle? x y z
        x = y
        y = z
    ]
]

isosceles?: function [x y z][
    and? triangle? x y z any? @[
        x = y
        y = z
        x = z
    ]
]

scalene?: function [x y z][
    and? triangle? x y z and? x <> y y <> z
]