sumOfMultiples: function [factors limit][
therange: 0..(dec limit)
listofvalues: map factors 'f [ 
            if? zero? f -> []
            else        -> select therange 'v [zero?v%f] ]
if (limit =< min factors) -> return 0
uniquemultiples: (fold.seed: [] listofvalues [a,b]->   union a b)
return (sum uniquemultiples)
]