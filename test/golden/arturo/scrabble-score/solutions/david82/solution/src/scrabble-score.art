; Define letter scores using a dictionary
letterScores: #[
    ; Score 1
    a: 1  e: 1  i: 1  o: 1  u: 1  l: 1  n: 1  r: 1  s: 1  t: 1
    ; Score 2
    d: 2  g: 2
    ; Score 3
    b: 3  c: 3  m: 3  p: 3
    ; Score 4
    f: 4  h: 4  v: 4  w: 4  y: 4
    ; Score 5
    k: 5
    ; Score 8
    j: 8  x: 8
    ; Score 10
    q: 10  z: 10
]

score: function [word][
    ; Handle empty string case
    if empty? word -> return 0
    
    ; Convert word to lowercase and sum letter scores
    sum map to [:char] lower word 'letter [
        letterScores\[letter]
    ]
]
