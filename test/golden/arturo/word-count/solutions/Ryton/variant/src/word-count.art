countWords: $[sentence][
replaced: replace (lower sentence) (split.every:2 ".,?!#&@$%^:") " "  
wordswithapostrophs: split.words replaced
print wordswithapostrophs
CleanedWordList: []
loop wordswithapostrophs [words][
    temp: new words    
    replace 'temp {/^[\']/} "" ; remove beginning apo
    replace 'temp {/[\']$/} ""  ; remove end apo
    if not? zero? (size temp) -> 'CleanedWordList ++ temp
]
return tally CleanedWordList
]