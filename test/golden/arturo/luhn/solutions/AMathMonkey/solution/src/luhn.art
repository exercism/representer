luhn?: function [value][
    s: reverse value
    sumv: 0
    digits: 0
    double: false
    loop s 'c [
        when [
            numeric? c [
                d: to :integer to :string c
                if double [
                    'd * 2
                    if d > 9 -> 'd - 9
                ]
                'sumv + d
                'digits + 1
                double: not? double
            ]
            not? whitespace? c [
                return false
            ]
        ]
    ]
    and? [digits > 1] [zero? sumv % 10]
]
