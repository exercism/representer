az: map ('a'..'z') 'v [to :string v]
cypher: #.raw (flatten couple az (reverse az))

encode: function[phrase] [
        phrase  | lower 
                | translate cypher 
                | replace " " ""  
                | translate #[" ":"", ",":"", ",":""]
                | replace "." ""
                | split.every:6 
                | join.with:" "
        ]
decode: $[coded] [ 
        coded  | encode  
               | replace " " ""
                 ]  
