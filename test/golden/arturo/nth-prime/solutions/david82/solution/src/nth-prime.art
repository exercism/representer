isPrime?: function [number][
    if number =< 1 -> return false
    
    ; Quick return for first few prime numbers
    if contains? [2 3 5 7] number -> return true
    
    ; Check if divisible by 2
    if zero? number % 2 -> return false

    testDivisor: 3
    
    while [(testDivisor * testDivisor) =< number][
        if (number % testDivisor) = 0 -> return false
        'testDivisor + 2  ; Only check odd divisors
    ]
    
    return true
]

prime: function [nthPosition][
    if nthPosition < 1 -> return false
    ; For nthPosition = 1, return 2 directly
    if nthPosition = 1 -> return 2

    select.n: nthPosition 2..∞ => isPrime?
]
