modifier: $ => [
	& | sub 10
	  | fdiv 2
	  | floor
]

ability: $ => [
	4 | map => [random 1 6]
	  | sort
	  | drop
	  | sum
]

makeCharacter: $ => [
	#.raw @[
		'strength ability
		'dexterity ability
		'constitution cons: <= ability
		'intelligence ability
		'wisdom ability
		'charisma ability
		'hitpoints 10 + modifier cons
	]
]