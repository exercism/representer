; Binary search implementation that finds the index of a target value in a sorted array
; Returns the index if found, null if not found
binarySearch: function [array, target, leftBound, rightBound][
    ; Validate input parameters
    if empty? array -> return null
    if null? target -> return null
    
    ; Base case: if bounds cross, element not found
    if rightBound < leftBound -> return null
    
    ; Calculate middle index using bit shift for efficiency
    middle: shr leftBound+rightBound 1
    
    ; Compare target with middle element and recursively search appropriate half
    return when.has: target [
        ; If target is less than middle element, search left half
        [< array\[middle]] -> binarySearch array target leftBound middle-1
        
        ; If target is greater than middle element, search right half
        [> array\[middle]] -> binarySearch array target middle+1 rightBound
        
        ; If equal, we found the target
        true              -> middle
     ]
]

; Wrapper function that provides a simpler interface for binary search
; Takes an array and a value to find
; Returns the index of the value if found, null if not found
find: function [values, value][  
    ; Handle empty array case
    if empty? values -> return null
    
    ; Call binary search with initial bounds
    binarySearch values value 0 dec size values
]
