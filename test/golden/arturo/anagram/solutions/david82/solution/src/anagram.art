findAnagrams: function [subject candidates][
    result: []
    lowSubject: lower subject
    sortedSubject: sort to [:char] lowSubject

    loop candidates 'candidate [
        lowCandidate: lower candidate
        
        ; Skip if the words are the same (case-insensitive)
        if equal? lowSubject lowCandidate [
            continue
        ]
        
        ; Convert to characters and sort for comparison
        sortedCandidate: sort to [:char] lowCandidate
        
        ; Check if it's an anagram by comparing sorted lowercase characters
        if equal? sortedSubject sortedCandidate [
            'result ++ candidate
        ]
    ]

    return result
]
