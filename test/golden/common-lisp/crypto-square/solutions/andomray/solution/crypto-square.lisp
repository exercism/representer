(defpackage :crypto-square
  (:use :cl)
  (:export :encipher))

(in-package :crypto-square)

(defun str-to-list (str)
  "Returns a list of lower-case chars (corresponding to str), excluding chars
which are not alphanumeric."
  (loop for c across str
        when (alphanumericp c)
          collect (char-downcase c)))

(defun finalize-dims (len rows cols)
  "Check to make sure the number of cols and rows generated by the
'calc-matrix-dims' function meets the criteria, returning a cons-cell of the
number of rows and cols. NOTE: even though this is meant to check/correct any
possible mistakes in setting the dimensions, this may not be robust enough for
all possible values."
  (if (and (>= cols rows)
           (<= (- cols rows) 1)
           (>= (* cols rows) len))
      (list rows cols)
      (finalize-dims len (1+ rows) cols)))

(defun calc-matrix-dims (char-list)
  "Calculates the prospective dimensions of the matrix which will hold the letters
in char-list, to be checked by 'finalize-dims'."
  (let* ((len (length char-list))
         (c (ceiling (sqrt len)))
         (r (floor   (sqrt len))))
    (finalize-dims len r c)))

(defun split-into-lists (char-list cols &optional (acc (list)))
  "Takes char-list (simply a list of chars) and breaks it up returning a list of
lists where each sublist has cols elements."
  (if (null char-list)
      (reverse acc)
      (split-into-lists (subseq char-list cols) cols (cons (subseq char-list 0 cols) acc))))

(defun format-list-for-matrix (char-list dims)
  "Coordinates the process of splitting the char-list into a list of lists."
  (destructuring-bind (rows cols) dims
    (let ((diff (- (* rows cols) (length char-list))))
      (if (zerop diff)
          (split-into-lists char-list cols)
          (split-into-lists (append char-list (make-list diff :initial-element #\Space)) cols))))) ; If char-list is not same size as (* rows cols), we append spaces to the end of char-list

(defun transpose-chars (matrix)
  "Given the matrix, returns a list of lists where each list (from left to right)
corresponds to a column (from top to bottom) of the matrix."
  (let ((rows (first  (array-dimensions matrix)))
        (cols (second (array-dimensions matrix))))
    (loop for c from 0 to (1- cols)
          collect (loop for r from 0 to (1- rows)
                        collect (aref matrix r c)))))

(defun format-output (result-list &optional (count 0) (acc ""))
  "Converts the list-of-lists returned by 'transpose-chars' into a string."
  (cond
    ((null result-list) acc)
    ((zerop count) (format-output (rest result-list) (1+ count) (concatenate 'string (coerce (first result-list) 'string) acc)))
    (t  (format-output (rest result-list) (1+ count) (concatenate 'string (coerce (first result-list) 'string) " " acc)))))

(defun encipher (plaintext)
  "Outputs a string representing the encoded version of plaintext."
  (let ((parsed-text (str-to-list plaintext)))
    (cond
      ((zerop (length parsed-text)) "")
      ((= 1 (length parsed-text)) (string (first parsed-text)))
      (t (let* ((dims (calc-matrix-dims parsed-text))
                (parsed-text-for-matrix (format-list-for-matrix parsed-text dims))
                (matrix (make-array dims :initial-contents parsed-text-for-matrix)))
           (format-output (reverse (transpose-chars matrix))))))))
