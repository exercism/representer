armstrongNumbers.isArmstrongNumber : Nat -> Boolean
armstrongNumbers.isArmstrongNumber number =
    natLen : Nat -> Nat
    natLen n = n |> Nat.toText |> Text.size

    number 
        |> Nat.toText
        |> Text.toCharList
        |> List.map (c -> pow ((Optional.getOrElse 0 (Text.toNat (Char.toText c)))) (natLen number))
        |> List.foldLeft (Nat.+) 1
        |> Nat.eq number