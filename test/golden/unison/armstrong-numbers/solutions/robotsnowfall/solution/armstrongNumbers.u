adder : Nat -> Nat -> Char -> Nat
adder e acc c = acc + (Nat.pow ((Char.toNat c) - (Char.toNat ?0)) e)

isArmstrongNumber : Nat -> Boolean
isArmstrongNumber n =
  match Nat.toTextBase 10 n with
    None -> false
    Some(t) ->
      cs = Text.toCharList t
      (List.foldLeft (adder (Text.size t)) 0 cs) == n

---

test> check (isArmstrongNumber 9)
test> check (not (isArmstrongNumber 10))
test> check (isArmstrongNumber 153)
test> check (not (isArmstrongNumber 154))
