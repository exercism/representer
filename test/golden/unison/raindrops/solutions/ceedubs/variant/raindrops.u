factors = [
  (3, "Pling"),
  (5, "Plang"),
  (7, "Plong")
]

convert : Nat -> Text
convert n =
  textMaybe = cases (factor, text) ->
    if mod n factor != 0 then Some text else None
  texts = filterMap textMaybe factors
  match texts with
    [] -> Nat.toText n
    stuff -> List.foldLeft (++) "" stuff