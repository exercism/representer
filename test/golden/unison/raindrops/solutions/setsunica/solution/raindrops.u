raindrops.convert : Nat -> Text
raindrops.convert n = 
  [(3, "Pling"), (5, "Plang"), (7, "Plong")]
    |> (List.foldLeft_ empty cases
         r, (i, t) 
           | n % i == 0 -> r ++ t
           | otherwise  -> r)
    |> (cases
         t 
           | Text.isEmpty t -> Nat.toText n
           | otherwise      -> t)
     
  
