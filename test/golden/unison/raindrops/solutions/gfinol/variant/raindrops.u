raindrops.convert : Nat -> Text
raindrops.convert n = 

    check p sound = 
        result input = if mod n p != 0 then input Text.++ sound else input
        result
    
    check3 = check 3 "Pling"
    check5 = check 5 "Plang"
    check7 = check 7 "Plong"

    result = "" |> check3 |> check5 |> check7

    if result != "" then result else Nat.toText n