diamond.rows : Char -> [Text]
diamond.rows letter =
  chars     = toNat letter |> rangeClosed (toNat ?A) |> mapOptional fromNat
  rowLength = size chars * 2 - 1
  rowCenter = size chars - 1
  blankLine = fill rowLength ?\s
  generateLine : Nat -> Char -> Text
  generateLine n c =
    blankLine
      |> replace (rowCenter + n) c
      |> replace (rowCenter - n) c
      |> fromCharList
  top = mapIndexed generateLine chars
  bottom = reverse top |> drop 1
  top ++ bottom
