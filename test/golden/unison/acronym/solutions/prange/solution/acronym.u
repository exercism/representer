use base
use test

abbreviate : Text -> Text
abbreviate test = 
  arr = Text.segmentBy (c -> and (not (Char.isWhitespace c))  (not (isDash c))) test
  abbrs = arr  |> List.map (Text.dropWhile isLoDash) |>  List.map (Text.take 1) |> Text.join "" |> Text.toUppercase
  abbrs


isDash : Char -> Boolean
isDash c = c Char.== ?-

isLoDash : Char -> Boolean
isLoDash c = c Char.== ?_