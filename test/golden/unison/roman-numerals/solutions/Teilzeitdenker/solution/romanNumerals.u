romanNumerals.lookup = [    
    (1000, "M"),
    (900 , "CM"),
    (500 , "D"),
    (400 , "CD"),
    (100 , "C"),
    (90  , "XC"),
    (50  , "L"),
    (40  , "XL"),
    (10  , "X"),
    (9   , "IX"),
    (5   , "V"),
    (4   , "IV"),
    (1   , "I"),
]

romanNumerals.toRoman : Nat -> Text
romanNumerals.toRoman n = 
    getNumeral n acc = 
        if n == 0 then acc else
            match List.head (List.filter (t -> (at1 t) <= n) lookup) with 
            None   -> acc
            Some t -> getNumeral (n - at1 t) (acc ++ at2 t)                     
    getNumeral n ""
    

