romanNumerals.toRoman : Nat -> Text
romanNumerals.toRoman decimal =
  loop n l acc =
    match l with
    [] -> acc
    (v, k) +: t ->
        if v Nat.<= n
        then loop (n - v) l (acc List.:+ k)
        else loop n t acc

  loop decimal ref_table []
    |> Text.join ""

ref_table = [
    (1000, "M"),
    (900, "CM"),
    (500, "D"),
    (400, "CD"),
    (100, "C"),
    (90, "XC"),
    (50, "L"),
    (40, "XL"),
    (10, "X"),
    (9, "IX"),
    (5, "V"),
    (4, "IV"),
    (1, "I")]
