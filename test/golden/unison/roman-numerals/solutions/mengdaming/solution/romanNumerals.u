romanNumerals.toRoman : Nat -> Text
romanNumerals.toRoman decimal =
    convert decimal ""

romanNumerals.convert : Nat -> Text -> Text
romanNumerals.convert decimal acc =
    if decimal == 0 then acc
    else
        (arabic, roman) = 
            [  
                (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
                (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
                (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I") 
            ]
                |> List.find (n -> decimal >= Tuple.at1 n) |> Optional.getOrElse (0, "")
        convert (decimal - arabic) (acc ++ roman)
