sumOfMultiples.sumOfMultiples : [Nat] -> Nat -> Nat
sumOfMultiples.sumOfMultiples targets upperBound = let
  multipleOf: [Nat] -> Nat -> Boolean
  multipleOf targets n =
    List.any (
      target -> 
        target > 0 && 
        ((Nat.mod n target) == 0)
    ) targets

  List.range 1 upperBound
    |> filter (multipleOf targets)
    |> sum

