bob.response : Text -> Text
bob.response sentence =
  shouting text = text === List.map ascii.toUpper text && List.any isUpper text
  match toCharList (trim sentence) with
    []         -> "Fine. Be that way!"
    text :+ ?? ->
      match shouting text with
        true  -> "Calm down, I know what I'm doing!"
        false -> "Sure."
    text       | shouting text -> "Whoa, chill out!"
    _          -> "Whatever."