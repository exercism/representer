clock.create : Int -> Int -> Text
clock.create hour minute =
  h = mod (minute / +60 + hour) +24 |> toText |> alignRightWith 2 ?0
  m = mod minute +60                |> toText |> alignRightWith 2 ?0
  h ++ ":" ++ m

clock.add : Int -> Int -> Int -> Text
clock.add hour min additionalMinutes =
  clock.create hour (min + additionalMinutes)

clock.subtract : Int -> Int -> Int -> Text
clock.subtract hours minutes minutesSubtract =
  clock.create hours (minutes - minutesSubtract)

clock.equal : (Int, Int) -> (Int, Int) -> Boolean
clock.equal =
  cases (h1, m1), (h2, m2) -> clock.create h1 m1 == clock.create h2 m2
