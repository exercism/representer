
sublist.takeAt: Nat -> [a] -> Nat  -> [a]
sublist.takeAt num lst idx = 
    take num <| drop idx lst

sublist.isSuperlist : [a] -> [a] -> Boolean
sublist.isSuperlist listOne listTwo = 
    indexes = List.range 0 (size listOne + (size listTwo) + 1)
    listTwoLength = size listTwo
    checker = (===) listTwo << (takeAt listTwoLength listOne) 
    List.any checker indexes
    

unique type sublist.SublistType = Equal | Sublist | Superlist | Unequal
{{ determine if the first argument, `listOne`, is a sublist of `listTwo`, a superlist of `listTwo`, equal to `listTwo`, or unequal }}
sublist.sublist : [a] -> [a] -> SublistType
sublist.sublist listOne listTwo =
    if listOne === listTwo then
        Equal
    else if sublist.isSuperlist listOne listTwo then
        Superlist
    else if sublist.isSuperlist listTwo listOne then
        Sublist
    else
        Unequal
  










