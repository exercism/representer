isogram.isIsogram : Text -> Boolean
isogram.isIsogram text = 
    -- delete symbols
    chars = text 
                |> Text.toLowercase  
                |> toCharList 
                |> List.filter (c -> 
                    not (isWhitespace c) &&
                    (c Char.!= ?-))
    -- unique chars
    singles = chars |> List.toSet |> Set.size
    -- all valid chars
    direct  = chars |> List.size
    -- make comparation
    direct === singles
