collatzConjecture.steps : Nat -> Optional Nat
collatzConjecture.steps n = 
  
  stepsRec: Nat -> Nat -> Nat
  stepsRec = cases
    1, step -> step 
    num, step ->
      nextNum = if Nat.isEven num then num / 2 else 3 * num + 1
      stepsRec nextNum (step + 1)

  if n == 0 then None else Some (stepsRec n 0)
