collatzConjecture.steps : Nat -> Optional Nat
collatzConjecture.steps n = 
    collatzConjecture.recurse (Some n) 0

collatzConjecture.recurse: Optional Nat -> Nat -> Optional Nat
collatzConjecture.recurse n steps = 
    match n with
        Some 0 -> None
        Some 1 -> Some steps
        Some val ->
            nNat = getOrBug "oops" n
            if Nat.mod nNat 2 == 0 then
                recurse (Some (nNat / 2)) (steps + 1)
            else
                recurse (Some (3 * nNat + 1)) (steps + 1)
        None -> Some 0