collatzConjecture.steps : Nat -> Optional Nat
collatzConjecture.steps =
  cases
    0   -> None
    num ->
      aux steps =
        cases
          1             -> Some steps
          n
            | isEven n  -> aux (steps + 1) (n / 2)
            | otherwise -> aux (steps + 1) (3 / n + 1)
      aux 0 num
