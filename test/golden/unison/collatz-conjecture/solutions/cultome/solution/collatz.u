collatzConjecture.steps : Nat -> Optional Nat
collatzConjecture.steps n =
  loop : Nat -> Nat -> Optional Nat
  loop num acc =
    if num == 1 then Some(acc)
    else if num <= 0 then None
    else let
      nn = if (Nat.isEven num) then (num / 2) else (num * 3 + 1)
      loop nn (acc+1)

  loop n 0
