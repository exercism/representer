allYourBase.rebase : Int -> [Int] -> Int -> Optional [Int]
allYourBase.rebase inputBase inputDigits outputBase =
  use Int % * / < <= ^
  use List reverse
  if +2 <= inputBase && +2 < outputBase
    && List.all (d -> +0 <= d && d < inputBase) inputDigits then
    s =
      inputDigits
        |> reverse
        |> List.indexed
        |> (List.map cases (d, i) -> d * inputBase ^ i)
        |> Int.sum
    List.unfold
      s (s -> (if +0 < s then Some (s % outputBase, s / outputBase) else None))
      |> reverse
      |> (l -> (if List.isEmpty l then [+0] else l))
      |> Some
  else None