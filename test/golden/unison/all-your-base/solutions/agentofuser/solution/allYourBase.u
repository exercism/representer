Int.toNat : Int -> Optional Nat
Int.toNat n =
  use Int >=
  if n >= +0 then Some (Int.truncate0 n) else None
  

allSomesOrNone: [Optional a] -> Optional [a]
allSomesOrNone opts =
  somes = List.somes opts
  if size somes === size opts then
    Some somes
  else
    None


allYourBase.digitsToNat: Nat -> [Nat] -> Nat
allYourBase.digitsToNat inputBase inputDigits =
  inputDigits
    |> List.reverse
    |> List.indexed
    |> List.map (cases (d, i) -> d * (Nat.pow inputBase i))
    |> Nat.sum

allYourBase.natToDigits: Nat -> Nat -> [Nat]
allYourBase.natToDigits outputBase number =
  List.unfold
      number
      (number' ->
        if number' > 0 then
          quotient = number' / outputBase
          remainder = Nat.mod number' outputBase
          Some (remainder, quotient)
        else
          None)
    |> reverse
    |> (digits -> if digits === [] then [0] else digits)

allYourBase.rebase : Int -> [Int] -> Int -> Optional [Int]
allYourBase.rebase inputBase inputDigits outputBase =
  optNatInputBase = Int.toNat inputBase
  optNatInputDigits =
    inputDigits
      |> List.map Int.toNat
      |> allSomesOrNone
  optNatOutputBase = Int.toNat outputBase

  match (optNatInputBase, optNatInputDigits, optNatOutputBase) with
    (None, _, _) -> None
    (_, None, _) -> None
    (_, _, None) -> None
    (Some ib, Some ids, Some ob) | (ib === 0) || (ob === 0) -> None
    (Some ib, Some ids, Some ob) | (ib === 1) || (ob === 1) -> None
    (Some ib, Some ids, Some ob) ->
      if List.any (d -> d >= ib) ids then
        None
      else
        ids
          |> digitsToNat ib
          |> natToDigits ob
          |> List.map Nat.toInt
          |> Some