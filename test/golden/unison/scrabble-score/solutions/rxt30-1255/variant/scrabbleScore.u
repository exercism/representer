getScore : Char -> Nat
getScore = cases
  x
    | x == ?D || x == ?G -> 2
    | x == ?B || x == ?C || x == ?M || x == ?P -> 4
    | x == ?F || x == ?H || x == ?V || x == ?W || x == ?Y -> 4
    | x == ?K -> 5
    | x == ?J || x == ?X -> 8
    | x == ?Q || x == ?Z -> 10
    | otherwise -> 1

scrabbleScore.score : Text -> Nat
scrabbleScore.score = 
  Text.toUppercase >>
  toCharList >>
  List.map (getScore) >>
  Nat.sum
