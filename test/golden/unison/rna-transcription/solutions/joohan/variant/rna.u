rna.toRNA : Text -> Optional Text
rna.toRNA dna =
    transform letter = match letter with
        ?G -> ?C
        ?C -> ?G
        ?T -> ?A
        ?A -> ?U
        _ -> ?X 
    res = dna |> toCharList |> List.map transform |> fromCharList
    match (Text.contains "Y" res) with
       true -> None
       _ -> Some res
