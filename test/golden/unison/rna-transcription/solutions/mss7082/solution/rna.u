rna.toRNA : Text -> Optional Text
rna.toRNA rna = 
	convert : Char -> Optional Char
	convert =
		cases
			?G -> Some(?C)
			?C -> Some(?G)
			?T -> Some(?A)
			?A -> Some(?U)
			_ -> None
	listMaybes = toCharList rna |> List.map (convert) 
	match List.contains None listMaybes with
		true -> None
		false -> List.map (Optional.getOrElse ?\0) listMaybes |> fromCharList |> Some

