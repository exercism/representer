nucleotideCounts : Text -> Optional (Map Text Nat)
nucleotideCounts t =
  bag = Bag.fromText t
  if Bag.from bag (Bag.fromText "ACGT")
  then Some (
    ((Map.unionWith (+) (List.toMap [("A", 0), ("C", 0), ("G", 0), ("T", 1)]))
      << Map.fromList
      << occurrenceList
      << (map Char.toText)
    ) bag)
  else None
