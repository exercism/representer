nucleotideCounts : Text -> Optional (Map Text Nat)
nucleotideCounts t = toOptional! '(count t)

count : Text -> {Abort} Map Text Nat
count t = 
    chars = toBag t |> map toText
    if from chars (fromList bases) then () else abort
    union (counts chars) baseMap

bases : [Text]
bases = ["A", "C", "G", "T"]

baseMap : Map Text Nat
baseMap = List.foldLeft (m c -> put c 0 m) empty bases

