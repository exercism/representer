unique type Color = Red | Orange | Yellow | Green | Blue | Purple

majorityFinder : [Color] -> Optional Color
majorityFinder colors =
  threshold = List.size colors / 2
  step b c = match Bag.add c b with
    b2 | Bag.count c b2 > threshold -> throw c -- stop early, we found it!
       | otherwise                  -> b2
  handle List.foldLeft step Bag.empty colors 
  with cases
    { Throw.throw maj -> _ } -> Some maj
    { _ } -> None