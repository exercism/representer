structural type linkedL.LinkedList a = Nil | Tree a (linkedL.LinkedList a)

linkedL.LinkedList.new : a -> LinkedList a
linkedL.LinkedList.new a = Tree a Nil

linkedL.LinkedList.cons : a -> LinkedList a -> LinkedList a
linkedL.LinkedList.cons a ls = Tree a ls

linkedL.LinkedList.nil : LinkedList a
linkedL.LinkedList.nil = Nil

linkedL.LinkedList.fromList : [a] -> LinkedList a
linkedL.LinkedList.fromList xs = 
  List.foldRight (cur -> acc -> cons cur acc ) nil xs

linkedL.LinkedList.head : LinkedList a -> Optional a
linkedL.LinkedList.head linkedList = match linkedList with
  Nil -> None
  Tree a _ -> Some a

linkedL.LinkedList.isNil : LinkedList a -> Boolean
linkedL.LinkedList.isNil linkedList = match linkedList with
  Nil -> true
  Tree _ _ -> false

linkedL.LinkedList.tail : LinkedList a -> LinkedList a
linkedL.LinkedList.tail linkedList = match linkedList with
  Nil -> nil
  Tree _ rest -> rest

linkedL.LinkedList.reverseLinkedList : LinkedList a -> LinkedList a
linkedL.LinkedList.reverseLinkedList linkedList =
  innerFunc : LinkedList a -> LinkedList a -> LinkedList a
  innerFunc acc cur = match cur with 
    Nil -> acc
    Tree hd tl -> innerFunc (cons hd acc) tl

  innerFunc nil linkedList  

linkedL.LinkedList.toList : LinkedList a -> [a]
linkedL.LinkedList.toList linkedList = 
  innerFunc : LinkedList a -> [a] -> [a]
  innerFunc linkedList acc = match linkedList with
    Nil -> acc
    Tree hd tl -> innerFunc tl (acc :+ hd)

  innerFunc linkedList []