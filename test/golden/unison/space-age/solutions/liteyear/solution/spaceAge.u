use Optional map

spaceAge.age : Text -> Nat -> Optional Float
spaceAge.age planet earthAgeSeconds =
  map (period -> (toFloat earthAgeSeconds / 31557600.0) / period) (Map.get planet orbitalPeriod)

spaceAge.orbitalPeriod : Map Text Float
spaceAge.orbitalPeriod = Map.fromList [
  ("Mercury", 0.2408467),
  ("Venus", 0.61519726),
  ("Earth", 1.0),
  ("Mars", 1.8808158),
  ("Jupiter", 11.862615),
  ("Saturn", 29.447498),
  ("Uranus", 84.016846),
  ("Neptune", 164.79132)]
