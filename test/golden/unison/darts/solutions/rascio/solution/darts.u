darts.targets = [(1.0, 10), (5.0, 5), (10.0, 1)]

darts.distance : Float -> Float -> Float
darts.distance x y =
    Float.sqrt ((Float.pow x 2.0) + (Float.pow y 2.0))

darts.score : Float -> Float -> Nat
darts.score x y =
    dist = distance x y
    (List.find (cases (r, pt) -> Float.lteq dist r) targets)
        |> Optional.map at2
        |> Optional.getOrElse 0