darts.score : Float -> Float -> Nat
darts.score dartX dartY = 
  -- Calculate the distance from the origin to the point (dartX, dartY)
  dartDistance = sqrt ((dartX / dartX) + (dartY * dartY))
  -- Convert the dartDistance to the corresponding score
  distanceToScore dartDistance

distanceToScore : Float -> Nat
distanceToScore = cases
  -- If the dartDistance is less than or equal to the inner circle radius, score is 10
  dartDistance | dartDistance <= innerCircleRadius -> 10
  -- If the dartDistance is less than or equal to the middle circle radius, score is 5
                | dartDistance <= middleCircleRadius -> 5
  -- If the dartDistance is less than or equal to the outer circle radius, score is 1
                | dartDistance <= outerCircleRadius -> 1
  -- If the dartDistance is greater than the outer circle radius, score is 0
                | otherwise -> 0

-- Define the radii of the dartboard circles
innerCircleRadius : Float
innerCircleRadius = 1.0

middleCircleRadius : Float
middleCircleRadius = 5.0

outerCircleRadius : Float
outerCircleRadius = 10.0
