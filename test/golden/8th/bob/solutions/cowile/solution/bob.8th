: 0= 0 n:= ;
: 0<> 0= not ;
: match \ s s -- f
  r:new r:match 0<> nip ;

: question \ s -- f
  "\\?$" match
;

: yell \ s -- f
 dup "[a-z]" match not swap
 "[A-Z]" match and
;

: silence \ s -- f
  "^[[:space:]]*$" match
;

: bob \ s -- s
  dup dup question swap yell and if drop "Calm down, I know what I'm doing!" ;then
  dup question if drop "Sure." ;then
  dup yell if drop "Whoa, chill out!" ;then
  dup silence if drop "Fine. Be that way!" ;then
  drop "Whatever."
;