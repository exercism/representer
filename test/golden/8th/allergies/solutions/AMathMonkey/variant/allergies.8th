needs combinators/dip

["eggs", "peanuts", "shellfish", "strawberries", "tomatoes", "chocolate", "pollen", "cats"]
constant all-allergies

: list \ n -- a 
  >r a:new 
  all-allergies ( 
    r@ rot n:shr 2 band if a:push else drop then
  ) a:each drop
  rdrop
;

: allergic-to? \ n s -- T
  ' list dip ' s:= a:indexof null? not 2nip
;
