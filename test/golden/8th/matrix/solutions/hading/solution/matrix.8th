needs combinators/dip

: parse-matrix \ s -> mat
  "\n" s:/   \ now have array of rows, space separated
  ( " " s:/ ) a:map
  ( ( >n ) a:map ) a:map
;

: row \ s n -- a
  ' parse-matrix dip
  n:1- a:_@
;

\ less efficient than the first solution submitted,
\ but in some sense clearer
: column \ s n -- a
  ( parse-matrix a:pivot ) dip 
  n:1- a:_@
;
