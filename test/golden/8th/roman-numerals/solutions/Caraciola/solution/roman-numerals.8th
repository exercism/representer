[1000, 900,  500, 400,  100, 90,   50,  40,   10,  9,    5,   4,    1 ] constant num-lookup
["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"] constant roman-lookup

: n:>roman  \ n -- s
"" >r num-lookup a:len nip n:1- 0 swap 
( num-lookup swap a:_@ n:/mod dup 
if roman-lookup I a:_@ swap ( dup r> swap s:+ >r ) swap times drop 
else drop  then
) -rot loop
drop r>
;