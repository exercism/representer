: slices \ s n -- a
  swap s:len \ n s n1
  rot dup \ s n1 n n
  rot \ s n n n1
  n:> \ s n T
  over 1 \ s n T n 1
  n:< \ s n T T
  or if 2drop a:new ;then

  "starting now" . cr
  dup rot \ n n s
  s:len \ n n s n1
  rot \ n s n1 n
  n:- \ n s n2
  ( \ n s n0
    >r 2dup r> \ n s n s n0
    rot s:slice \ n s s1
    r> swap a:push >r \ n s
  ) 0 \ n s n2 w 0
  rot \ n s w 0 n2
  a:new >r loop \ n s
  2drop r>
;