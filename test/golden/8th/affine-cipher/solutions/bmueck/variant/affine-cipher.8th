: code \ s w -- s
  "do-code" w:!
  (
    dup '0 '9 between if;

    'a +
    "do-code" w:@ w:exec
    26 mod
    'a +
  ) s:map
;

locals:
: mmi \ n -- n
  "a" w:!
  (
    dup "a" w:@ n:*
    26 mod 1 =
    if break "a" w:! else drop then
  ) 1 25 loop
  "a" w:@
;

locals:
: >code \ s n n -- s
  swap dup 26 n:gcd 1 = !if 3drop null ;then

  "a" w:! "b" w:!
  s:lc /[^a-z0-9]/ "" s:replace!
  ( "a" w:@ n:* "b" w:@ n:+ ) code
  [5] s:/ " " a:join
;

locals:
: code> \ s n n -- s
  swap dup 26 n:gcd 1 = !if 3drop null ;then

  mmi "a" w:! "b" w:!
  / / "" s:replace!
  .s
  ( "b" w:@ n:- "a" w:@ n:* ) code
;