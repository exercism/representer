: darts-score \ x y -- n
  \ Calculate distance squared: x² + y²
  n:sqr swap n:sqr n:+
  
  \ Check against radius thresholds (using squared distances to avoid square root)
  dup 1 n:> not if drop 10 ;then     \ radius ≤ 1: inner circle (10 points)
  dup 25 n:> not if drop 5 ;then     \ radius ≤ 5: middle circle (5 points)  
  dup 100 n:> not if drop 1 ;then    \ radius ≤ 10: outer circle (1 point)
  drop 0                             \ radius > 10: miss (0 points)
;
