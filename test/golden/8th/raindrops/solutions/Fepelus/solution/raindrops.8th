
: add-if-factor \ s n n s -- s n
  >r _dup n:mod 0 n:= if
    swap r> s:+ swap
  else
    rdrop
  then
;

: default-to-number \ s n -- s
  swap dup "" s:= if
    drop >s
  else
    nip
  then
;

: raindrops \ n -- s
  "" swap
  3 "Pling" add-if-factor
  5 "Plang" add-if-factor
  7 "Plong" add-if-factor
  default-to-number
;

