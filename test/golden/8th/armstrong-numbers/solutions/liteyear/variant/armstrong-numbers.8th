\ put the character '0' on TOS
: char0 \ -- c
  "0" 0 s:@ nip
;

\ convert digit character to its numerical value
: >digit \ c -- n
  char0 n:-
;

: armstrong? \ n -- T
  dup     \ n n
  >s      \ n s
  s:len   \ n s n
  >r      \ n s { n }
  ( >digit r@ n:^ n:+ ) 1 s:reduce \ n n { n }
  rdrop   \ n n
  n:=     \ T
;
