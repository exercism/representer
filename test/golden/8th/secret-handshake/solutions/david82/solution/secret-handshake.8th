\ Secret Handshake - Convert number to sequence of actions based on binary bits

\ Action strings for each bit position
["wink", "double blink", "close your eyes", "jump"] constant ACTIONS

\ Check if a specific bit is set in the number
: bit-set? \ n bit -- T
  n:band 0 n:>
;

\ Main function to convert number to secret handshake commands
: commands \ n -- a
  >r a:new
  r@ 1 bit-set? if "wink" a:push then
  r@ 2 bit-set? if "double blink" a:push then
  r@ 4 bit-set? if "close your eyes" a:push then
  r@ 8 bit-set? if "jump" a:push then
  r@ 16 bit-set? if a:rev then
  rdrop
;
