16 constant max.items

: weight
  "weight" m:_@
;

: value
  "value" m:_@
;

: total.weight
  ( weight n:+ ) 0 a:reduce
;

: total.value
  ( value n:+ ) 0 a:reduce
;

: limit.value
  over total.weight n:< if drop 0 else total.value then
;

: bit n:shr 1 band ;

: I0 I n:1- ;

: bitmap a:new ( over I0 bit a:push ) max.items times nip ;

: select
  a:new -rot
  ( rot drop 1 n:= if a:push else drop then ) a:2each
  2drop
;

\ brute force works here. Not efficient but sufficient
: maximum-value \ n a -- n
  >r
  0 swap ( r@ I0 bitmap select over limit.value rot n:max swap ) 1 max.items n:shl times drop rdrop
;