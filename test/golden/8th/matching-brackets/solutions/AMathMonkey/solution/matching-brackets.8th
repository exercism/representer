var fail

: paired? \ s -- T
  false fail !
  a:new >r
  (
    dup '{ n:= if drop '} ' a:push rop! ;then
    dup '[ n:= if drop '] ' a:push rop! ;then
    dup '( n:= if drop ') ' a:push rop! ;then
    "}])" over s:search nip null? nip !if 
      ( a:pop swap ) rop! 0 ?: n:= !if true fail ! then
    ;then
    drop
  ) s:each!
  fail @ if rdrop false ;then
  r> a:_len 0 n:=
;
