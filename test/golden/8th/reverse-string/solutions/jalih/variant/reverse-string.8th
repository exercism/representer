\ Following should work but there is currently a bug in s:<> implementation
\ : reverse  \ s -- s
\  s:len dup 1 n:> !if
\    drop
\  else
\    2 n:/ n:int n:1- swap
\    ( dup n:1+ n:neg s:<> ) 0 3 roll loop
\  then ;

: reverse \ s -- s
  s:len dup 1 n:> !if
    drop
  else
    2 n:/ n:int n:1- swap
    null s:/
    ( dup n:1- n:neg a:<> ) 0 3 roll loop
    "" a:join
  then ;
