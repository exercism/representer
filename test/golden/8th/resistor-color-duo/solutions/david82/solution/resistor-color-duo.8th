\ Color array with indices matching their numeric values
: colors \ -- a
  ["black", "brown", "red", "orange", "yellow", "green", "blue", "violet", "grey", "white"]
;

\ Convert color name to numeric value
: color-code \ s -- n
  colors swap ' s:= a:indexof nip
;

\ Calculate two-digit resistor value from color array
: value \ a -- n
  [10, 1] swap              \ Set place values for tens and units
  ( color-code n:* ) a:2map \ Convert colors to values and multiply by place value
  ' n:+ 0 a:reduce          \ Sum the results
;
