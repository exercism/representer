: distance \ s1 s2 -- n
    s:len2 n:= if                   \ s1 s2
        0 -rot                      \ count s1 s2
        (                           \ count s1 ix n2
            -rot s:@ rot            \ count s1 n1 n2
            n:= if 0 else 1 then    \ count s1 increment
            rot n:+ swap            \ count+increment s1
        ) s:each
        drop
    else
        2drop null
    then
;
