1 constant ONE
2 constant TWO

: next-factor \ n -- n
    dup TWO n:= !if n:1+ then n:1+
;

: increment-factor \ n n -- n n
    repeat
    2dup n:mod !if ;then
    next-factor
    again
;

: factors \ n -- a
    a:new >r TWO 
    
    repeat
      over ONE n:>
      !if      
        2drop break
      else
        increment-factor
        swap over n:/ swap
        dup r> a:push >r
      then  
    again
    r>
;
