0 constant ZERO
2 constant TWO

{
  "C": "clover",
  "G": "grass",
  "R": "radishes",
  "V": "violets"
} constant plant-map

: code>plant \ s -- s
  plant-map swap m:_@
;

: s>garden \ s -- a
  "\n" s:/
  ( null s:/ ) a:map
  ( ' code>plant a:map ) a:map
;

: student>index \ s -- n \ Convert name to index, taking advantage of alphabetical order
  ZERO s:@ nip 'A n:-
;

: col-offset \ n1 n2 -- n n1 = col# n2 = student-index
  TWO n:* n:+
;

: plant#>row/col TWO n:/mod swap ;

: plant@ \ g n1 n2 -- p \ g = garden n1 = student-index n2 = plant 0-3
  plant#>row/col
  rot col-offset >r
  a:_@ r> a:_@
;

: plants \ s s - a
  student>index swap s>garden swap
  2dup 2dup 2dup
  [0, 2, 2, 3] ' plant@ a:map
;
