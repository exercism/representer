: scores \ a -- a
  \ Return the scores array unchanged
  noop
;

: latest \ a -- n
  \ Get the last (most recent) score from the array
  -1 a:_@
;

: personal-best \ a -- n
  \ Find the highest score by sorting and getting the last element
  ' n:cmp a:sort -1 a:_@
;

: personal-top-three \ a -- a
  \ Get top 3 scores in descending order with single sort operation
  ' n:cmp a:sort a:rev    \ Sort ascending then reverse to get descending
  0 3 a:slice             \ Take first 3 elements with explicit start index
;
