\ Check if string contains only valid nucleotides (A, C, G, T)
: valid-nucleotides-only? \ s -- T
  /[GACT]/ "" s:replace! s:len 0 n:=
;

: nucleotide-counts \ s -- m
  dup valid-nucleotides-only? not
  if 2drop null ;then
  drop
  null s:/ ( ) a:group ( a:len 2nip ) m:map  
  {"T":0,"G":0,"C":0,"A":0} swap m:+ 
;
