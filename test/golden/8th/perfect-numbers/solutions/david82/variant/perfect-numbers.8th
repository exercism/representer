\ Perfect Numbers - Classification based on aliquot sum

: add-if-divisor \ sum divisor -- sum'
  dup r@ swap n:mod 0 n:= if n:+ else drop then
;

: sum-of-factors \ n -- n
  dup >r 0 swap ( add-if-divisor ) 1 rot 2 n:/ loop
  rdrop
;

: classify \ n -- s
  dup 1 n:< if drop null ;then
  dup sum-of-factors n:cmp
  dup 1 n:< if drop "abundant" ;then
  dup 0 n:> if drop "deficient" ;then
  drop "perfect"
;
