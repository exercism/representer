: triangle? \ n n n -- T
  2 pick 2 pick n:+
  over n:>
  2 pick 2 pick n:+
  4 pick n:>
  4 pick 3 pick n:+
  4 pick n:>
  and and
  nip nip nip
;
: equilateral? \ n n n -- T
  2 pick 2 pick 2 pick triangle?
  3 pick 3 pick n:=
  3 pick 3 pick n:=
  and and
  nip nip nip
;
: isosceles? \ n n n -- T
  2 pick 2 pick 2 pick triangle?
  3 pick 3 pick n:=
  3 pick 3 pick n:=
  3 pick 6 pick n:=
  or or and
  nip nip nip
;
: scalene? \ n n n -- T
  2 pick 2 pick 2 pick triangle?
  3 pick 3 pick 3 pick isosceles?
  not and
  nip nip nip
;
