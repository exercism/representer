0 constant ZERO
1 constant ONE

["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"] constant counts
"green bottle" constant GREEN_BOTTLE
"hanging on the wall" constant HANGING_ON_WALL
"And if" constant AND_IF
"should accidentally fall" constant ACCIDENTALLY_FALL
"There'll be" constant THERELL_BE

: capitalize \ s -- s
    ZERO s:@ s:uc ZERO swap s:!
;

: bottles \ n -- s
    dup ONE n:= if "" else "s" then swap counts swap a:_@ " " s:+ GREEN_BOTTLE s:+ "%s%s" s:strfmt
;

: verse \ n -- s
    dup
    n:1- bottles swap
    bottles capitalize
    ONE bottles swap dup
    "%s " s:strfmt HANGING_ON_WALL s:+ ",\n%s " s:+ HANGING_ON_WALL s:+ ",\n" s:+ AND_IF s:+ " %s " s:+ ACCIDENTALLY_FALL s:+ ",\n" s:+ THERELL_BE s:+ " %s " s:+ HANGING_ON_WALL s:+ "." s:+
    s:strfmt
;

: recite \ n n -- s
    2dup n:1- n:- -rot >r ' verse -rot loop- r> a:close "\n\n" a:join
;
