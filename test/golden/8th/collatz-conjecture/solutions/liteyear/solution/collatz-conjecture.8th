: collatz \ n -- n
  dup 0 n:> !if      \ Check for non-positive input
    drop null ;;     \ and if so, return null.
  then
  0 swap             \ n n
  repeat
    dup 1 n:= if     \ n n
      drop ;;
    then
    dup n:odd? if    \ n n
      3 n:* 1 n:+    \ n n
    else
      2 n:/          \ n n
    then
    swap n:1+ swap   \ n n
  again
;
