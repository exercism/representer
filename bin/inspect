#!/usr/bin/env ruby

# Synopsis:
# Show how a language's representer sees a file, to help write its rules.

# Arguments:
# $1: track slug
# $2: path to a source file

# Output:
# The parsed tree (with field names and anonymous tokens, before any rules
# run), followed by the representation and mapping.

# Example:
# ./bin/inspect ruby path/to/two_fer.rb

require_relative "../lib/representer"

track_slug, path = ARGV
abort "usage: ./bin/inspect track-slug path/to/file" unless track_slug && path

language = Representer::Languages.for(track_slug)
source = File.read(path)

def show(node, depth = 0)
  label = node.named? ? node.type : node.type.inspect
  label = "#{node.field}: #{label}" if node.field
  label += " #{node.text.inspect}" if node.named? && node.leaf?
  puts "#{'  ' * depth}#{label}"
  node.children.each { |child| show(child, depth + 1) }
end

if language == Representer::Languages::Basic
  puts "#{track_slug} has no class of its own, so it uses Basic."
else
  puts "Parsed tree:"
  show(Representer::Engine::Grammar[language.grammar].parse(Representer::Engine.clean(source)))
end

result = Representer::RepresentSolution.(track_slug, { File.basename(path) => source }, {})
puts "\nRepresentation (#{result.representer.name.split('::').last}, version #{result.version}):"
puts result.representation
puts "\nMapping: #{result.mapping}"
