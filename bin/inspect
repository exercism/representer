#!/usr/bin/env ruby

# Synopsis:
# Show how Inspector sees a file, to help write its rules.

# Arguments:
# $1: track slug
# $2: path to a source file

# Output:
# The parsed tree (with field names and anonymous tokens, before any stage
# runs), followed by the representation, the mapping and the snippet.

# Example:
# ./bin/inspect ruby path/to/two_fer.rb

require_relative "../lib/inspector"

track_slug, path = ARGV
abort "usage: ./bin/inspect track-slug path/to/file" unless track_slug && path

language = Inspector::Languages.for(track_slug)
source = File.read(path)

# Inspector ignores files named like tests or config files, such as
# leap_test.gleam, so such a file is represented as solution.gleam.
filename = File.basename(path)
if Inspector::Engine.test_or_config_file?(filename)
  renamed = "solution#{File.extname(filename)}"
  puts "Inspector ignores files named like #{filename}, so this represents it as #{renamed}.\n\n"
  filename = renamed
end

if language != Inspector::Languages::Basic && !language.source_file?(filename)
  puts "Inspector ignores #{filename}, because #{track_slug} only reads #{language.extensions.join(', ')} files.\n\n"
end

def show(node, depth = 0)
  label = node.named? ? node.type : node.type.inspect
  label = "#{node.field}: #{label}" if node.field
  label += " #{node.text.inspect}" if node.named? && node.leaf?
  puts "#{'  ' * depth}#{label}"
  node.children.each { |child| show(child, depth + 1) }
end

if language == Inspector::Languages::Basic
  puts "#{track_slug} has no language of its own, so it uses Basic."
else
  puts "Parsed tree:"
  show(Inspector::Engine::Grammar[language.grammar].parse(Inspector::Engine.clean(source)))
end

result = Inspector::RepresentSolution.(track_slug, { filename => source })
language_name = result.language.name.delete_suffix("::Common::Spec").split("::").last
puts "\nRepresentation (#{language_name}, version #{result.version}):"
puts result.representation
puts "\nMapping: #{result.mapping}"

snippet = Inspector::Generate.(track_slug, { filename => source }, outputs: [:snippet])[:snippet]
puts "\nSnippet (version #{snippet[:version]}):"
puts snippet[:snippet] || snippet[:message]
