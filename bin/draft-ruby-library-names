#!/usr/bin/env ruby

# Synopsis:
# Draft Ruby's library names list (lib/representer/languages/library_names/
# ruby.txt) from what the golden Ruby solutions call.
#
# A student's method keeps its name if the name is in the list, so the list
# only needs the methods where the choice of method is something a mentor
# comments on: `def sum(a) = a.sum` and `def max(a) = a.max` must stay
# apart. This finds them like this:
#
# 1. In every golden Ruby solution, it collects the method names called on
#    a receiver (`xs.sum`) or passed as a block (`&:sum`), apart from the
#    names that the same solution defines.
# 2. It keeps only the methods of Ruby's value classes (Object, Kernel,
#    Comparable, Enumerable, Array, Hash, String, Symbol, Integer, Float,
#    Rational, Complex, Range, Set, Struct, Proc, Regexp, MatchData and
#    Time) and Math's functions, and no operators, so names that only look
#    like library calls go.
# 3. It adds the methods that Ruby itself calls, such as `initialize`.

# Output:
# The new list, written to ruby.txt. Review it with `git diff`.

# Example:
# ./bin/draft-ruby-library-names

require_relative "../test/golden"

Ruby = Representer::Languages::Ruby
include Representer::Engine::TreeHelpers # rubocop:disable Style/MixinUsage

CALLS = ["(call receiver: (_) method: (identifier) @name)", "(block_argument (simple_symbol) @name)"].freeze
DEFINITIONS = ["[(method name: (identifier) @name) (singleton_method name: (identifier) @name)]"].freeze

# Methods that Ruby calls itself, so a student's method with the name means
# something to Ruby.
PROTOCOL = %w[
  initialize initialize_copy to_s to_str inspect to_a to_ary to_h to_hash to_i to_int to_f to_proc to_sym
  each eql? hash call coerce method_missing respond_to_missing? included extended inherited prepended succ
].freeze

VALUE_CLASSES = [Object, Kernel, Comparable, Enumerable, Array, Hash, String, Symbol, Integer, Float, Rational,
                 Complex, Range, Set, Struct, Proc, Regexp, MatchData, Time].freeze

called = Set.new
Golden.solutions("ruby").each do |solution|
  trees = solution.files.select { |name, _| Ruby.source_file?(name) }.values.filter_map do |source|
    Ruby::Normalise.(Ruby::GenerateAST.(Representer::Engine::Grammar["ruby"].parse(Representer::Engine.clean(source))))
  rescue Representer::CannotRepresent
    nil
  end
  defined = names_in(trees, Ruby, *DEFINITIONS)
  called.merge(names_in(trees, Ruby, *CALLS) - defined)
end

library = VALUE_CLASSES.flat_map { |klass| klass.public_instance_methods + klass.private_instance_methods }.to_set
library.merge(Math.methods(false))
names = called.select { |name| name.match?(/\A[a-z_]\w*[?!]?\z/) && library.include?(name.to_sym) }

path = File.join(__dir__, "../lib/representer/languages/library_names/ruby.txt")
File.write(path, "#{<<~HEADER}#{(names | PROTOCOL).sort.join("\n")}\n")
  # Ruby's methods where the choice of method is something a mentor comments
  # on. If a student defines a method with one of these names, the Ruby
  # representer keeps the name, so a student's sum that calls Array#sum can't
  # merge with a student's max that calls Array#max. bin/draft-ruby-library-names
  # made this list from the methods that the golden Ruby solutions call, and
  # added the methods that Ruby calls itself.
HEADER
puts "Wrote #{(names | PROTOCOL).size} names to #{File.expand_path(path)}"
