#!/usr/bin/env bash

# Synopsis:
# The git pre-commit hook. It finds the Ruby named in .ruby-version and runs
# bin/regenerate-staged-golden with it, which regenerates the golden data of
# any language that the commit changes (see test/golden/README.md).
# Run bin/setup-hooks to install it.

# Output:
# The tracks it regenerated, and the golden files that changed. If it can't
# find a suitable Ruby, it says where it looked and stops the commit.

# Notes:
# A hook runs with the shell's environment, which may have a different Ruby
# on its PATH, so this looks for the right one:
#
# 1. The Ruby on the PATH, if its version is the one in .ruby-version.
# 2. That exact version, installed by chruby (~/.rubies or /opt/rubies),
#    rbenv, asdf, rvm or mise.
# 3. Otherwise, the newest installed Ruby with the same major and minor
#    version (such as 3.4.4 for 3.4.12), with a warning.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
wanted="$(tr -d '[:space:]' < "${root}/.ruby-version")"
wanted="${wanted#ruby-}"
minor="$(echo "${wanted}" | cut -d. -f1,2)"

# The folders where a Ruby version manager installs each version. Each
# one holds bin/ruby.
install_dirs() {
  local version="$1"
  echo "${HOME}/.rubies/ruby-${version}"
  echo "/opt/rubies/ruby-${version}"
  echo "${RBENV_ROOT:-${HOME}/.rbenv}/versions/${version}"
  echo "${ASDF_DATA_DIR:-${HOME}/.asdf}/installs/ruby/${version}"
  echo "${HOME}/.rvm/rubies/ruby-${version}"
  echo "${HOME}/.local/share/mise/installs/ruby/${version}"
}

ruby_version() { "$1" -e 'print RUBY_VERSION' 2>/dev/null || true; }

ruby_bin=""
if command -v ruby > /dev/null && [ "$(ruby_version ruby)" = "${wanted}" ]; then
  ruby_bin="$(dirname "$(command -v ruby)")"
else
  for dir in $(install_dirs "${wanted}"); do
    if [ -x "${dir}/bin/ruby" ]; then
      ruby_bin="${dir}/bin"
      break
    fi
  done
fi

if [ -z "${ruby_bin}" ]; then
  # The newest installed patch release of the same minor version.
  newest=""
  for dir in $(install_dirs "${minor}.*"); do
    [ -x "${dir}/bin/ruby" ] || continue
    version="$(ruby_version "${dir}/bin/ruby")"
    if [ -z "${newest}" ] || [ "$(printf '%s\n%s\n' "${newest}" "${version}" | sort -V | tail -1)" = "${version}" ]; then
      newest="${version}"
      ruby_bin="${dir}/bin"
    fi
  done
  if [ -n "${ruby_bin}" ]; then
    echo "pre-commit: Ruby ${wanted} (from .ruby-version) isn't installed, so this uses Ruby ${newest}." >&2
  fi
fi

if [ -z "${ruby_bin}" ]; then
  cat >&2 <<MESSAGE
pre-commit: Can't find Ruby ${wanted}, which .ruby-version names.
The Ruby on your PATH is $(ruby_version ruby || true), and no Ruby ${minor} is installed in:
$(install_dirs "${minor}.*" | sed 's/^/  /')
Install Ruby ${wanted} (for example with ruby-install or rbenv), run bundle install with it, and commit again.
MESSAGE
  exit 1
fi

# If this is a different Ruby from the shell's, the shell's gem settings
# belong to the other Ruby, so they go.
if [ "${ruby_bin}" != "$(dirname "$(command -v ruby 2>/dev/null || echo /none/ruby)")" ]; then
  unset GEM_HOME GEM_PATH GEM_ROOT
fi
export PATH="${ruby_bin}:${PATH}"

cd "${root}"
# The source files are UTF-8, whatever the shell's locale.
exec "${ruby_bin}/ruby" -E UTF-8 bin/regenerate-staged-golden
