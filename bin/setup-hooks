#!/usr/bin/env bash

# Synopsis:
# Install bin/pre-commit as this clone's git pre-commit hook.

# Example:
# ./bin/setup-hooks

set -e

hooks_dir="$(git rev-parse --git-path hooks)"
mkdir -p "${hooks_dir}"
cat > "${hooks_dir}/pre-commit" <<'HOOK'
#!/usr/bin/env bash
exec "$(git rev-parse --show-toplevel)/bin/pre-commit"
HOOK
chmod +x "${hooks_dir}/pre-commit"
echo "Installed the pre-commit hook in ${hooks_dir}/pre-commit"
